# --- AI bot (/api/chat) proxy to the self-hosted model over the Cloudflare tunnel ---
# Copy this file to `.env` and fill in your values. .env is gitignored.

# Full chat-completions URL of your home model (OpenAI-compatible / Ollama).
# Example: https://ai.minhojan-world.site/v1/chat/completions
AI_API_URL=

# Model name to request (e.g. llama3.1, qwen2.5, etc.)
AI_MODEL=default

# Optional bearer token for the model API.
AI_API_KEY=

# Optional: if the model endpoint is behind Cloudflare Access, set a service token.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Optional: override the assistant's system prompt.
# AI_SYSTEM_PROMPT=
