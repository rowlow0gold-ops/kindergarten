---
import { useT, localizePath, type Locale } from "../i18n/ui";
import siteKo from "../data/site.json";
import siteEn from "../data/en/site.json";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useT(locale);
const site = locale === "en" ? siteEn : siteKo;
const p = (path: string) => localizePath(path, locale);

const pathname = Astro.url.pathname;
const altPath = locale === "en" ? (pathname.replace(/^\/en/, "") || "/") : ("/en" + (pathname === "/" ? "" : pathname));

const nav = [
  { href: p("/about/milestones"), label: t("nav.milestones") },
  { href: p("/schools"), label: t("nav.schools") },
  { href: p("/admissions"), label: t("nav.admissions") },
  { href: p("/contact"), label: t("nav.contact") },
];
---
<header class="site-header is-scrolled sticky top-0 z-50 bg-white">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-4">
    <a href={p("/")} class="font-serif text-lg font-semibold text-navy-900 leading-tight">{site.name}</a>
    <nav class="hidden items-center gap-7 md:flex">
      {nav.map((n) => (
        <a href={n.href} class="nav-link text-sm font-medium text-ink/80 transition hover:text-navy">{n.label}</a>
      ))}
      <a href={altPath} class="rounded-full border border-navy/20 px-3 py-1 text-xs font-semibold text-navy transition hover:bg-navy hover:text-white">{t("lang.switch")}</a>
      <a href={p("/admissions")} class="rounded-full bg-gold px-4 py-2 text-sm font-semibold text-navy-900 transition hover:brightness-95">{t("nav.apply")}</a>
    </nav>
    <button data-mobile-toggle aria-expanded="false" aria-label="Menu" class="md:hidden text-navy-900">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>
  <div data-mobile-panel class="hidden border-t border-black/5 bg-white md:hidden">
    <div class="mx-auto flex max-w-6xl flex-col gap-1 px-5 py-3">
      {nav.map((n) => (<a href={n.href} class="rounded-lg px-2 py-2 text-sm font-medium text-ink/80 hover:bg-cream">{n.label}</a>))}
      <div class="mt-2 flex gap-3">
        <a href={altPath} class="rounded-full border border-navy/20 px-3 py-2 text-xs font-semibold text-navy">{t("lang.switch")}</a>
        <a href={p("/admissions")} class="rounded-full bg-gold px-4 py-2 text-sm font-semibold text-navy-900">{t("nav.apply")}</a>
      </div>
    </div>
  </div>
</header>
