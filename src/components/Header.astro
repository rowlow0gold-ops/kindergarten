---
import { useT, localizePath, type Locale } from "../i18n/ui";
import Logo from "./Logo.astro";
import siteKo from "../data/site.json";
import siteEn from "../data/en/site.json";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useT(locale);
const site = locale === "en" ? siteEn : siteKo;
const p = (path: string) => localizePath(path, locale);
const pathname = Astro.url.pathname;
const altPath = locale === "en" ? (pathname.replace(/^\/en/, "") || "/") : ("/en" + (pathname === "/" ? "" : pathname));
const L = (ko: string, en: string) => (locale === "en" ? en : ko);

const nav = [
  { label: L("학교 소개", "About"), href: p("/about/milestones") },
  { label: L("캠퍼스", "Campuses"), href: p("/schools") },
  { label: L("방과후 · 특별", "Enrichment"), href: p("/enrichment/afterschool") },
  { label: L("소식", "News"), href: p("/news") },
  { label: L("입학 안내", "Admissions"), href: p("/admissions") },
  { label: L("문의", "Contact"), href: p("/contact") },
];
---
<header class="site-header is-scrolled sticky top-0 z-50 bg-white">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-4">
    <a href={p("/")} class="flex shrink-0 items-center gap-2.5"><Logo class="h-8 w-8" /><span class="font-serif text-lg font-semibold leading-tight text-navy-900">{site.name}</span></a>
    <nav class="hidden items-center gap-1.5 lg:flex">
      {nav.map((n) => (
        n.children ? (
          <div class="group relative">
            <button class="nav-link flex items-center gap-1 rounded-md px-3 py-2 text-[15px] font-medium text-ink/80 transition hover:text-navy">
              {n.label}
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="invisible absolute left-0 top-full min-w-52 translate-y-1 rounded-xl border border-black/5 bg-white p-2 opacity-0 shadow-lg transition group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
              {n.children.map((c) => (
                <a href={c.href} class="block rounded-lg px-3 py-2 text-sm text-ink/80 transition hover:bg-cream hover:text-navy">{c.label}</a>
              ))}
            </div>
          </div>
        ) : (
          <a href={n.href} class="nav-link rounded-md px-3 py-2 text-[15px] font-medium text-ink/80 transition hover:text-navy">{n.label}</a>
        )
      ))}
      <a href={altPath} class="ml-1 rounded-full border border-navy/20 px-3 py-1 text-xs font-semibold text-navy transition hover:bg-navy hover:text-white">{t("lang.switch")}</a>
      <a href={p("/admissions")} class="ml-2 rounded-full bg-navy-900 px-5 py-2 text-sm font-semibold uppercase tracking-wide text-white transition hover:bg-navy-700">{t("nav.apply")}</a>
    </nav>
    <button data-mobile-toggle aria-expanded="false" aria-label="Menu" class="lg:hidden text-navy-900">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>
  <div data-mobile-panel class="hidden max-h-[80vh] overflow-y-auto border-t border-black/5 bg-white lg:hidden">
    <div class="mx-auto flex max-w-7xl flex-col gap-1 px-5 py-3">
      {nav.map((n) => (
        n.children ? (
          <div class="py-1">
            <p class="px-2 pt-2 text-xs font-semibold uppercase tracking-wide text-gold">{n.label}</p>
            {n.children.map((c) => (<a href={c.href} class="block rounded-lg px-3 py-2 text-sm text-ink/80 hover:bg-cream">{c.label}</a>))}
          </div>
        ) : (
          <a href={n.href} class="rounded-lg px-2 py-2 text-sm font-medium text-ink/80 hover:bg-cream">{n.label}</a>
        )
      ))}
      <div class="mt-2 flex gap-3 px-2">
        <a href={altPath} class="rounded-full border border-navy/20 px-3 py-2 text-xs font-semibold text-navy">{t("lang.switch")}</a>
        <a href={p("/admissions")} class="rounded-full bg-gold px-4 py-2 text-sm font-semibold text-navy-900">{t("nav.apply")}</a>
      </div>
    </div>
  </div>
</header>
