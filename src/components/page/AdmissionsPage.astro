---
import { useT, localizePath, type Locale } from "../../i18n/ui";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useT(locale);
const p = (path: string) => localizePath(path, locale);
const c = {
  ko: {
    title: "입학 안내", sub: "2027학년도 신입생을 모집합니다.",
    stepsTitle: "지원 절차",
    steps: [
      { t: "입학 설명회 참석", d: "캠퍼스 투어와 설명회에서 한빛의 교육을 직접 확인하세요." },
      { t: "원서 및 서류 제출", d: "지원서, 필요 서류, 전형료를 제출합니다." },
      { t: "전형 및 학부모 면담", d: "학생 활동 관찰과 학부모 면담을 진행합니다." },
      { t: "합격 및 등록", d: "합격 안내 후 등록 절차를 완료합니다." },
    ],
    feesTitle: "전형료 안내",
    fees: [
      { k: "유아부 체험 수업", v: "₩20,000" },
      { k: "유치부 전형료", v: "₩90,000" },
      { k: "초등부 전형료", v: "₩250,000" },
      { k: "중등부 전형료", v: "₩350,000" },
    ],
    feeNote: "※ 데모용 예시 금액입니다. 실제 학비·전형료는 캠퍼스별로 안내됩니다.",
    cta: "문의하기",
  },
  en: {
    title: "Admissions", sub: "Now accepting applications for 2027.",
    stepsTitle: "Application Process",
    steps: [
      { t: "Attend an info session", d: "See Hanbit's education first-hand on a campus tour or session." },
      { t: "Submit application & documents", d: "Submit the application, required documents and the fee." },
      { t: "Assessment & parent meeting", d: "A student observation and a parent meeting take place." },
      { t: "Offer & enrolment", d: "Complete enrolment after the offer of admission." },
    ],
    feesTitle: "Examination Fees",
    fees: [
      { k: "Preschool trial lesson", v: "₩20,000" },
      { k: "Kindergarten fee", v: "₩90,000" },
      { k: "Primary fee", v: "₩250,000" },
      { k: "Secondary fee", v: "₩350,000" },
    ],
    feeNote: "※ Example figures for this demo. Actual tuition & fees are provided per campus.",
    cta: "Contact us",
  },
}[locale];
---
<section class="bg-navy-900 text-white">
  <div class="reveal mx-auto max-w-6xl px-5 py-20 text-center">
    <h1 class="font-serif text-4xl font-semibold md:text-5xl">{c.title}</h1>
    <p class="mt-4 text-white/70">{c.sub}</p>
  </div>
</section>
<section class="bg-white">
  <div class="mx-auto max-w-5xl px-5 py-16">
    <h2 class="reveal font-serif text-2xl font-semibold text-navy-900 md:text-3xl">{c.stepsTitle}</h2>
    <div data-reveal-children class="mt-10 grid gap-6 md:grid-cols-2">
      {c.steps.map((s, i) => (
        <div class="flex gap-4 rounded-2xl border border-black/5 bg-white p-6 shadow-sm">
          <span class="font-serif text-3xl font-semibold text-gold">{String(i + 1).padStart(2, "0")}</span>
          <div><h3 class="font-serif text-lg font-semibold text-navy-900">{s.t}</h3><p class="mt-2 text-sm leading-relaxed text-ink/70">{s.d}</p></div>
        </div>
      ))}
    </div>
  </div>
</section>
<section class="bg-cream">
  <div class="reveal mx-auto max-w-3xl px-5 py-16">
    <h2 class="font-serif text-2xl font-semibold text-navy-900 md:text-3xl">{c.feesTitle}</h2>
    <dl class="mt-8 divide-y divide-black/10 rounded-2xl bg-white px-6">
      {c.fees.map((f) => (
        <div class="flex items-center justify-between py-4">
          <dt class="text-sm text-ink/80">{f.k}</dt><dd class="font-serif text-lg font-semibold text-navy">{f.v}</dd>
        </div>
      ))}
    </dl>
    <p class="mt-4 text-xs text-ink/55">{c.feeNote}</p>
    <a href={p("/contact")} class="mt-8 inline-block rounded-full bg-gold px-6 py-3 text-sm font-semibold text-navy-900 transition hover:brightness-95">{c.cta}</a>
  </div>
</section>
