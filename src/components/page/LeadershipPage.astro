---
import { type Locale } from "../../i18n/ui";
import Figure from "../Figure.astro";
import staffKo from "../../data/staff.json";
import staffEn from "../../data/en/staff.json";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const staff = locale === "en" ? staffEn : staffKo;
const title = locale === "en" ? "Leadership & Advisors" : "리더십 · 자문";
---
<section class="bg-navy-900 text-white"><div class="reveal mx-auto max-w-6xl px-5 py-20"><h1 class="font-serif text-4xl font-semibold md:text-5xl">{title}</h1></div></section>
<section class="bg-cream"><div class="mx-auto max-w-6xl px-5 py-16">
  <div data-reveal-children class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {staff.map((s)=>(
      <div class="overflow-hidden rounded-2xl bg-white shadow-sm">
        <Figure alt={s.name} class="aspect-square" rounded="rounded-none" />
        <div class="p-5">
          <p class="text-xs font-semibold uppercase tracking-wide text-gold">{s.group}</p>
          <h2 class="mt-1 font-serif text-lg font-semibold text-navy-900">{s.name}</h2>
          <p class="text-sm font-medium text-navy/80">{s.title}</p>
          <p class="mt-2 text-sm leading-relaxed text-ink/70">{s.bio}</p>
        </div>
      </div>
    ))}
  </div>
</div></section>
