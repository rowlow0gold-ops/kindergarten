---
import { localizePath, type Locale } from "../../i18n/ui";
import branchesKo from "../../data/branches.json";
import branchesEn from "../../data/en/branches.json";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const p = (path: string) => localizePath(path, locale);
const branches = locale === "en" ? branchesEn : branchesKo;
const title = locale === "en" ? "Tuition & Fees" : "학비 안내";
const sub = locale === "en" ? "Fees vary by campus and age level. Select a campus." : "학비는 캠퍼스·연령별로 다릅니다. 캠퍼스를 선택하세요.";
---
<section class="bg-navy-900 text-white"><div class="reveal mx-auto max-w-6xl px-5 py-20"><h1 class="font-serif text-4xl font-semibold md:text-5xl">{title}</h1><p class="mt-4 text-white/75">{sub}</p></div></section>
<section class="bg-cream"><div class="mx-auto max-w-6xl px-5 py-16"><div data-reveal-children class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
  {branches.map((b)=>(
    <a href={p(`/admissions/tuition/${b.slug}`)} class="group rounded-2xl bg-white p-6 shadow-sm transition hover:shadow-md">
      <p class="text-xs font-semibold uppercase tracking-wide text-gold">{b.city}</p>
      <h2 class="mt-1 font-serif text-lg font-semibold text-navy-900 group-hover:text-navy">{b.name}</h2>
      <p class="mt-2 text-sm text-ink/70">{b.levels}</p>
    </a>
  ))}
</div></div></section>
