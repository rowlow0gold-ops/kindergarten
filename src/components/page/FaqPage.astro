---
import { type Locale } from "../../i18n/ui";
import faqKo from "../../data/faq.json";
import faqEn from "../../data/en/faq.json";
interface Props { locale: Locale; group: "admissions" | "academics"; }
const { locale, group } = Astro.props;
const data = (locale === "en" ? faqEn : faqKo) as Record<string, {q:string;a:string}[]>;
const items = data[group];
const title = group === "admissions" ? (locale==="en"?"Admissions FAQ":"입학 FAQ") : (locale==="en"?"Academics FAQ":"교육과정 FAQ");
---
<section class="bg-navy-900 text-white"><div class="reveal mx-auto max-w-4xl px-5 py-20"><h1 class="font-serif text-4xl font-semibold md:text-5xl">{title}</h1></div></section>
<section class="bg-white"><div class="mx-auto max-w-3xl px-5 py-16">
  <div data-reveal-children class="space-y-3">
    {items.map((f)=>(
      <details class="group rounded-xl border border-black/10 bg-white p-1">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-4 py-4 font-serif text-lg font-semibold text-navy-900">
          {f.q}
          <svg class="shrink-0 transition group-open:rotate-180" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
        </summary>
        <p class="px-4 pb-4 leading-relaxed text-ink/75">{f.a}</p>
      </details>
    ))}
  </div>
</div></section>
