---
import { useT, localizePath, type Locale } from "../../i18n/ui";
import Figure from "../Figure.astro";
import Logo from "../Logo.astro";
import pagesKo from "../../data/pages.json";
import pagesEn from "../../data/en/pages.json";
import faqKo from "../../data/faq.json";
import faqEn from "../../data/en/faq.json";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const _pages = (locale === "en" ? pagesEn : pagesKo);
const lv = _pages["learning-vision"];
const lk = _pages["learning-kindergarten"];
const lfaq = (locale === "en" ? faqEn : faqKo)["academics"];
const learnHead = locale === "en" ? "Learning at Hanbit" : "한빛의 교육";
const faqTitle = locale === "en" ? "Curriculum FAQ" : "교육과정 FAQ";
const t = useT(locale);
const p = (path: string) => localizePath(path, locale);
const c = {
  ko: {
    years: "10년.",
    rotate: ["자신감", "호기심", "즐거움"],
    rotatePre: "아이들이 ", rotatePost: " 을 키웁니다",
    lead: "첫 단어에서 유창한 영어로",
    banner: "교육을 향한 10년의 진심과 성장",
    msgTitle: "설립자의 메시지",
    msgBody: "한빛은 지난 10년간 아이 한 명 한 명의 호기심을 존중하며, 영어로 세상을 만나는 아이들을 길러왔습니다. 우리의 여정은 이제 다섯 도시로 이어집니다.",
    msgName: "설립자 · 교장",
    tlTitle: "우리를 만든 순간들",
    tlLabel: "성장의 기록",
    timeline: [
      { y: "2016–2018", t: "첫 발걸음", d: "서울에서 첫 유치 캠퍼스를 열고 영어 몰입 교육을 시작했습니다." },
      { y: "2019–2021", t: "성장의 시간", d: "수도권으로 캠퍼스를 확장하고 영어 교육과정을 체계화했습니다." },
      { y: "2022–2023", t: "전환점", d: "영어 놀이 중심으로 교육과정을 체계화했습니다." },
      { y: "2024–2025", t: "한빛의 정체성", d: "한빛 브랜드를 확립하고 전국 거점으로 도약했습니다." },
      { y: "2026", t: "미래를 향해", d: "다섯 도시 캠퍼스로 더 많은 가정과 함께합니다." },
    ],
    storiesTitle: "학부모의 이야기",
    quote: "선생님들이 정해진 교육과정을 아이 한 명 한 명에 맞춰 풀어내는 점이 정말 훌륭합니다. 감사합니다, 한빛!",
    quoteBy: "유치부 학부모, 서울 캠퍼스",
    ctaTitle: "한빛과 함께하시겠어요?",
  },
  en: {
    years: "10 Years.",
    rotate: ["Confidence", "Curiosity", "Joy"],
    rotatePre: "Helping children grow with ", rotatePost: "",
    lead: "From first words to fluent English",
    banner: "Honoring a decade of purpose & progress in education",
    msgTitle: "A Message From Our Founder",
    msgBody: "For ten years, Hanbit has honored each child's curiosity, raising future innovators who meet the world through English. Our journey now reaches five cities.",
    msgName: "Founder & Principal",
    tlTitle: "Milestones That Shaped Us",
    tlLabel: "Visual timeline",
    timeline: [
      { y: "2016–2018", t: "A Vision Takes Root", d: "We opened our first kindergarten campus in Seoul with an English-immersion approach." },
      { y: "2019–2021", t: "Growing Momentum", d: "We expanded across the capital region and formalised our English curriculum." },
      { y: "2022–2023", t: "A Pivotal Moment", d: "We formalised our play-based English curriculum." },
      { y: "2024–2025", t: "Our Identity", d: "We established the Hanbit brand and grew into a nationwide network." },
      { y: "2026", t: "Looking Forward", d: "Onward to five city campuses, together with more families." },
    ],
    storiesTitle: "Stories From Our Families",
    quote: "The teachers are brilliant at adapting a structured curriculum to each child's needs. Thank you, Hanbit!",
    quoteBy: "Kindergarten Parent, Seoul Campus",
    ctaTitle: "Ready to join Hanbit?",
  },
}[locale];
---
<!-- HERO (pinned) -->
<section class="relative flex min-h-[92vh] flex-col overflow-hidden bg-navy-900 text-white">
  <img src="https://images.pexels.com/photos/28336738/pexels-photo-28336738.png?auto=compress&cs=tinysrgb&w=1600&h=1000&fit=crop" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover" style="opacity:0.55" />
  <div class="absolute inset-0" style="background:linear-gradient(to bottom, rgba(17,29,56,0.55), rgba(17,29,56,0.8))"></div>
  <div class="absolute inset-0 opacity-[0.16]" style="background-image: radial-gradient(circle, #ffffff 1px, transparent 1px); background-size: 24px 24px;"></div>
  <div class="relative mx-auto flex w-full max-w-6xl flex-1 items-center justify-center px-5 text-center">
    <h1 class="reveal font-serif text-6xl font-semibold text-gold md:text-8xl"><span class="text-7xl [font-variant-numeric:lining-nums] md:text-9xl">{c.years.match(/^\d+/)?.[0]}</span>{c.years.replace(/^\d+/, "")}</h1>
  </div>
  <div class="relative z-10 h-10 bg-cream" style="border-top-left-radius: 60% 100%; border-top-right-radius: 60% 100%;"></div>
</section>

<div class="relative z-10">
<!-- ROTATING -->
<section class="relative overflow-hidden bg-cream">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <svg class="absolute -left-12 -bottom-12 h-60 w-60 text-gold-soft opacity-[0.18]" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.1"><circle cx="50" cy="50" r="20"/><circle cx="50" cy="50" r="32"/><circle cx="50" cy="50" r="44"/></svg>
    <svg class="absolute right-6 top-2 h-32 w-32 text-navy opacity-[0.06]" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2"><circle cx="50" cy="50" r="46"/></svg>
    <svg class="absolute right-[14%] bottom-3 h-20 w-20 text-gold-soft opacity-[0.3]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21V10"/><path d="M12 12C10.5 8.5 7 7 3 7c0 4 3 7 9 7z"/><path d="M12 13c1.3-3 4.5-4.5 8-4.5 0 3.6-3 6.5-8 6z"/></svg>
    <span class="absolute left-[18%] top-7 h-2.5 w-2.5 rounded-full bg-gold-soft opacity-40"></span>
    <span class="absolute right-[28%] bottom-10 h-2 w-2 rounded-full bg-navy/20"></span>
    <span class="absolute left-[40%] bottom-6 h-1.5 w-1.5 rounded-full bg-gold-soft opacity-50"></span>
    <svg class="absolute left-[5%] top-[40%] h-16 w-16 text-gold-soft opacity-[0.3]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21V10"/><path d="M12 12C10.5 8.5 7 7 3 7c0 4 3 7 9 7z"/><path d="M12 13c1.3-3 4.5-4.5 8-4.5 0 3.6-3 6.5-8 6z"/></svg>
    <svg class="absolute left-[1%] top-[56%] h-40 w-40 text-navy opacity-[0.05]" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2"><circle cx="50" cy="50" r="46"/></svg>
    <svg class="absolute right-[2%] top-[60%] h-52 w-52 text-gold-soft opacity-[0.14]" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.1"><circle cx="50" cy="50" r="24"/><circle cx="50" cy="50" r="38"/></svg>
    <span class="absolute left-[55%] top-[12%] h-2 w-2 rounded-full bg-navy/15"></span>
    <span class="absolute right-[42%] bottom-[16%] h-2.5 w-2.5 rounded-full bg-gold-soft opacity-40"></span>
    <span class="absolute left-[32%] bottom-[8%] h-1.5 w-1.5 rounded-full bg-navy/20"></span>
    <span class="absolute right-[12%] top-[8%] h-2 w-2 rounded-full bg-gold-soft opacity-40"></span>
  </div>
  <div class="reveal relative z-10 mx-auto flex max-w-4xl flex-col items-center px-5 pt-20 pb-16 text-center">
    <Logo class="mb-8 h-16 w-16 md:h-20 md:w-20" />
    <p class="font-serif text-3xl font-medium text-navy-900 md:text-5xl">
      {c.rotatePre}<span data-typewriter={JSON.stringify(c.rotate)} class="text-gold"></span><span class="tw-cursor text-gold">|</span>{c.rotatePost}
    </p>
  </div>
  <div class="relative z-10 mx-auto grid max-w-6xl items-center gap-10 px-6 pt-8 pb-28 md:grid-cols-2">
    <h2 class="reveal font-serif text-3xl font-semibold leading-tight text-navy-900 md:text-5xl">{c.lead}</h2>
    <div data-reveal-children class="relative mx-auto h-[440px] w-full max-w-md sm:h-[500px]">
      <div class="absolute left-0 top-6 aspect-[4/5] w-36 -rotate-[6deg] sm:w-44"><img src="https://images.pexels.com/photos/36928656/pexels-photo-36928656.jpeg?auto=compress&cs=tinysrgb&w=700&h=900&fit=crop" alt={locale === "en" ? "Children" : "아이들"} loading="lazy" class="h-full w-full rounded-2xl object-cover shadow-xl ring-4 ring-white" /></div>
      <div class="absolute left-[26%] top-0 z-30 aspect-[4/5] w-44 rotate-[3deg] sm:w-56"><img src="https://images.pexels.com/photos/2080960/pexels-photo-2080960.jpeg?auto=compress&cs=tinysrgb&w=700&h=900&fit=crop" alt={locale === "en" ? "Play" : "놀이"} loading="lazy" class="h-full w-full rounded-2xl object-cover shadow-2xl ring-4 ring-white" /></div>
      <div class="absolute right-0 top-12 z-20 aspect-square w-40 rotate-[7deg] sm:w-48"><img src="https://images.pexels.com/photos/31621101/pexels-photo-31621101.jpeg?auto=compress&cs=tinysrgb&w=800&h=800&fit=crop" alt={locale === "en" ? "Outdoors" : "야외"} loading="lazy" class="h-full w-full rounded-2xl object-cover shadow-xl ring-4 ring-white" /></div>
      <div class="absolute left-[10%] bottom-0 z-20 aspect-square w-36 rotate-[5deg] sm:w-44"><img src="https://images.pexels.com/photos/24705717/pexels-photo-24705717.jpeg?auto=compress&cs=tinysrgb&w=800&h=800&fit=crop" alt={locale === "en" ? "Garden" : "정원"} loading="lazy" class="h-full w-full rounded-2xl object-cover shadow-xl ring-4 ring-white" /></div>
      <div class="absolute right-[6%] bottom-4 z-10 aspect-[4/5] w-32 -rotate-[5deg] sm:w-40"><img src="https://images.pexels.com/photos/37026801/pexels-photo-37026801.jpeg?auto=compress&cs=tinysrgb&w=700&h=900&fit=crop" alt={locale === "en" ? "Discovery" : "탐구"} loading="lazy" class="h-full w-full rounded-2xl object-cover shadow-xl ring-4 ring-white" /></div>
    </div>
  </div>
</section>
<style is:global>
  @keyframes twblink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
  .tw-cursor { display: inline-block; margin-left: 1px; font-weight: 300; animation: twblink 1s steps(1) infinite; }
</style>
<script is:inline>
  (function () {
    var el = document.querySelector("[data-typewriter]");
    if (!el) return;
    var words = [];
    try { words = JSON.parse(el.getAttribute("data-typewriter")); } catch (e) { return; }
    if (words.length < 2) { el.textContent = words[0] || ""; return; }
    var wi = 0, ci = 0, deleting = false;
    function tick() {
      var w = words[wi];
      if (!deleting) {
        ci++; el.textContent = w.slice(0, ci);
        if (ci === w.length) { deleting = true; return setTimeout(tick, 1500); }
        return setTimeout(tick, 95);
      } else {
        ci--; el.textContent = w.slice(0, ci);
        if (ci === 0) { deleting = false; wi = (wi + 1) % words.length; return setTimeout(tick, 350); }
        return setTimeout(tick, 45);
      }
    }
    setTimeout(tick, 600);
  })();
</script>


<!-- HONORING (founder + stories on one backdrop) -->
<section class="relative overflow-hidden bg-navy-900 text-white">
  <img src="https://picsum.photos/seed/660/1600/900" alt={locale === "en" ? "Our community" : "한빛 공동체"} class="absolute inset-0 h-full w-full object-cover" />
  <div class="absolute inset-0 bg-navy-900/55"></div>
  <div class="relative mx-auto max-w-6xl px-6 py-24">
    <div class="reveal flex items-center gap-5">
      <Logo class="h-16 w-16 shrink-0 md:h-20 md:w-20" />
      <h2 class="font-serif text-2xl font-semibold leading-tight md:text-4xl">{c.banner}</h2>
    </div>
    <div class="mt-14 grid items-stretch gap-8 lg:grid-cols-2">
      <div class="reveal rounded-3xl bg-white/95 p-8 text-ink shadow-xl md:p-10">
        <h3 class="font-serif text-2xl font-semibold text-gold md:text-3xl">{c.msgTitle}</h3>
        <div class="mt-6 grid items-center gap-6 sm:grid-cols-[120px_1fr]">
          <Figure alt={locale === "en" ? "Founder portrait" : "설립자 사진"} class="aspect-square" rounded="rounded-2xl" />
          <div>
            <p class="leading-relaxed text-ink/80">{c.msgBody}</p>
            <p class="mt-4 text-sm font-semibold text-navy">{c.msgName}</p>
          </div>
        </div>
      </div>
      <div class="reveal flex flex-col justify-center rounded-3xl bg-white/95 p-8 text-ink shadow-xl md:p-10">
        <p class="text-sm font-semibold uppercase tracking-wide text-gold">{c.storiesTitle}</p>
        <p class="mt-5 font-serif text-xl font-medium leading-relaxed text-navy-900 md:text-2xl">“{c.quote}”</p>
        <p class="mt-6 text-sm italic text-ink/70">— {c.quoteBy}</p>
      </div>
    </div>

    <!-- Milestones / Visual Timeline (sub-content) -->
    <div class="mt-20">
    <p class="reveal text-sm font-semibold uppercase tracking-wide text-gold">{c.tlLabel}</p>
    <div class="reveal mt-2 flex items-end justify-between gap-4">
      <h2 class="font-serif text-3xl font-semibold md:text-5xl">{c.tlTitle}</h2>
      <div class="flex gap-2">
        <button data-tl-prev aria-label="Previous" style="background:#ffffff;color:#111d38" class="grid h-12 w-12 place-items-center rounded-full text-xl font-semibold shadow-lg transition hover:brightness-95">‹</button>
        <button data-tl-next aria-label="Next" style="background:#ffffff;color:#111d38" class="grid h-12 w-12 place-items-center rounded-full text-xl font-semibold shadow-lg transition hover:brightness-95">›</button>
      </div>
    </div>
    <div data-tl-track class="relative mt-10 flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth pb-4" style="scrollbar-width:none">
      {c.timeline.map((m) => (
        <div class="group w-[300px] shrink-0 snap-start overflow-hidden rounded-2xl bg-white/5 ring-1 ring-white/10 transition hover:ring-gold/60 sm:w-[340px]">
          <div class="relative aspect-[4/3] overflow-hidden">
            <Figure alt={m.t} class="absolute inset-0 h-full w-full transition duration-700 group-hover:scale-110" rounded="rounded-none" />
          </div>
          <div class="p-6">
            <p class="font-serif text-sm font-semibold text-gold">{m.y}</p>
            <h3 class="mt-1 font-serif text-xl font-semibold text-white">{m.t}</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/70">{m.d}</p>
          </div>
        </div>
      ))}
    </div>
    <div data-tl-dots class="mt-6 flex justify-center gap-2"></div>
    </div>
  </div>
</section>
<style is:global>[data-tl-track]::-webkit-scrollbar{display:none}</style>
<script is:inline>
  (function () {
    var track = document.querySelector("[data-tl-track]");
    if (!track) return;
    var cards = track.children;
    var prev = document.querySelector("[data-tl-prev]");
    var next = document.querySelector("[data-tl-next]");
    var dots = document.querySelector("[data-tl-dots]");
    var idx = 0, st;
    function clamp(i) { return Math.max(0, Math.min(i, cards.length - 1)); }
    function maxLeft() { return track.scrollWidth - track.clientWidth; }
    function stepW() { return cards.length > 1 ? (cards[1].offsetLeft - cards[0].offsetLeft) : (cards[0] ? cards[0].offsetWidth : 320); }
    function render() {
      if (dots) for (var i = 0; i < dots.children.length; i++) dots.children[i].className = "h-2 rounded-full transition-all " + (i === idx ? "w-5 bg-gold" : "w-2 bg-white/30");
      if (prev) prev.style.opacity = idx <= 0 ? "0.4" : "1";
      if (next) next.style.opacity = idx >= cards.length - 1 ? "0.4" : "1";
    }
    function go(i) {
      idx = clamp(i);
      var c = cards[idx];
      if (c) track.scrollTo({ left: Math.min(c.offsetLeft, maxLeft()), behavior: "smooth" });
      render();
    }
    if (prev) prev.onclick = function () { go(idx - 1); };
    if (next) next.onclick = function () { go(idx + 1); };
    if (dots) for (var i = 0; i < cards.length; i++) {
      var b = document.createElement("button");
      b.setAttribute("aria-label", "Slide " + (i + 1));
      (function (k) { b.onclick = function () { go(k); }; })(i);
      dots.appendChild(b);
    }
    track.addEventListener("scroll", function () {
      clearTimeout(st);
      st = setTimeout(function () {
        idx = track.scrollLeft >= maxLeft() - 2 ? cards.length - 1 : clamp(Math.round(track.scrollLeft / stepW()));
        render();
      }, 120);
    });
    window.addEventListener("resize", render);
    render();
  })();
</script>

<!-- LEARNING (moved from the Learning tab) -->

<!-- Philosophy feature: icon + big statement + bleeding photo -->
<section class="relative bg-navy-900 text-white">
  <div class="mx-auto max-w-6xl px-6 pt-24 pb-52">
    <div class="reveal grid items-center gap-10 md:grid-cols-[auto_1fr]">
      <svg viewBox="0 0 96 96" fill="none" stroke="currentColor" stroke-width="2" class="h-24 w-24 shrink-0 text-gold-soft md:h-28 md:w-28" aria-hidden="true">
        <circle cx="48" cy="48" r="13"/>
        <g stroke-linecap="round"><path d="M48 9v13"/><path d="M48 74v13"/><path d="M9 48h13"/><path d="M74 48h13"/><path d="M21 21l9 9"/><path d="M66 66l9 9"/><path d="M75 21l-9 9"/><path d="M30 66l-9 9"/></g>
      </svg>
      <p class="font-serif text-2xl leading-relaxed md:text-right md:text-3xl">A strong start in English opens a child's whole world. Our <span class="italic text-gold-soft">play-based English journey</span> — songs, stories and all-day immersion with native teachers — helps every child grow with curiosity and confidence.</p>
    </div>
  </div>
  <div class="relative z-10 mx-auto -mb-36 max-w-6xl px-6">
    <img src="https://images.pexels.com/photos/296301/pexels-photo-296301.jpeg?auto=compress&cs=tinysrgb&w=1600" alt={locale === "en" ? "Children learning together" : "함께 배우는 아이들"} loading="lazy" class="w-full rounded-3xl shadow-2xl ring-8 ring-white/10" />
  </div>
</section>

<!-- Numbered qualities: Philosophy & Curriculum + Ages 3–6 -->
<section class="bg-cream"><div class="mx-auto max-w-6xl px-6 pt-72 pb-20">
  <div class="rule-gold mb-6"></div>
  <h2 class="reveal font-serif text-3xl font-semibold text-navy-900 md:text-5xl">{learnHead}</h2>
  <div class="mt-12 grid items-start gap-12 lg:grid-cols-2">
    <div data-reveal-children>
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-gold">{lv.eyebrow} · {lk.eyebrow}</p>
      <h3 class="mt-2 font-serif text-2xl font-semibold text-navy-900 md:text-3xl">{lv.title}</h3>
      <p class="mt-3 max-w-md text-ink/75">{lv.intro}</p>
      <div class="mt-9 space-y-7">
        {[...lv.sections, ...lk.sections].map((s, i) => (
          <div class="flex gap-5">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-gold font-serif text-base font-semibold text-navy-900">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h4 class="font-serif text-xl font-semibold text-navy-900">{s.h}</h4>
              <p class="mt-1 leading-relaxed text-ink/70">{s.b}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="reveal lg:sticky lg:top-24">
      <img src="https://images.pexels.com/photos/207653/pexels-photo-207653.jpeg?auto=compress&cs=tinysrgb&w=800&h=1000&fit=crop" alt={locale === "en" ? "A child learning" : "배우는 아이"} loading="lazy" class="aspect-[4/5] w-full rounded-3xl object-cover shadow-xl" />
    </div>
  </div>
</div></section>

<!-- Curriculum FAQ (kept) -->
<section class="bg-white"><div class="mx-auto max-w-3xl px-6 py-20">
  <div class="rule-gold mb-6"></div>
  <h2 class="reveal font-serif text-3xl font-semibold text-navy-900 md:text-4xl">{faqTitle}</h2>
  <div data-reveal-children class="mt-8 space-y-3">
    {lfaq.map((f) => (
      <details class="group rounded-xl border border-black/10 bg-white p-1">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-4 py-4 font-serif text-lg font-semibold text-navy-900">
          {f.q}
          <svg class="shrink-0 transition group-open:rotate-180" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
        </summary>
        <p class="px-4 pb-4 leading-relaxed text-ink/75">{f.a}</p>
      </details>
    ))}
  </div>
</div></section>
</div>
