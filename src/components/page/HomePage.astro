---
import { useT, localizePath, type Locale } from "../../i18n/ui";
import Figure from "../Figure.astro";
import CurvedDivider from "../CurvedDivider.astro";
import Shapes from "../Shapes.astro";
import siteKo from "../../data/site.json";
import siteEn from "../../data/en/site.json";
import branchesKo from "../../data/branches.json";
import branchesEn from "../../data/en/branches.json";
import media from "../../data/media.json";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useT(locale);
const p = (path: string) => localizePath(path, locale);
const site = locale === "en" ? siteEn : siteKo;
const branches = locale === "en" ? branchesEn : branchesKo;
const _coords = { "seoul-gangnam":[37.497,127.027], "busan-haeundae":[35.163,129.160], "daejeon-yuseong":[36.362,127.356], "daegu-suseong":[35.858,128.630], "gwangju-namgu":[35.133,126.902] };
const mapPts = branches.map((b) => ({ label: b.city, lat: (_coords[b.slug] || [36.5,127.8])[0], lng: (_coords[b.slug] || [36.5,127.8])[1], href: p("/schools/" + b.slug), flagship: false }));
const seeMap = locale === "en" ? "Find out the location" : "위치 찾아보기";
const c = {
  ko: { heroTitle:"영어 학습을 삶으로", heroSub:"유치 영어 과정 · 전국 5개 도시 캠퍼스", missionTitle:"독립적으로 사고하고 더 나은 사회에 기여하는 미래의 혁신가를, 생애 첫 배움에서부터 키웁니다.", introEyebrow:"교육 철학", introTitle:"대한민국 대표\n국제 영어 유치원", introBody:"21세기 아이의 잠재력을 여는 데에는 탄탄한 영어 기초가 필수입니다. 한빛은 유치 시기에 원어민 교사와 함께 영어를 놀이로 익히며, 자연스러운 영어 환경 속에서 호기심과 자신감을 키웁니다.", curriculum:"교육과정 보기", diffEyebrow:"한빛의 차별점", diffTitle:"영어가 자연스러운\n일상이 되는 유치원", diff:[{t:"원어민 영어 몰입",d:"하루 종일 영어로 소통하는 자연스러운 몰입 환경."},{t:"놀이 중심 영어 학습",d:"노래, 놀이, 이야기로 영어를 즐겁게 익힙니다."},{t:"전인 교육",d:"영어와 함께 사회성, 정서, 창의력을 균형 있게."},{t:"세심한 돌봄",d:"소규모 학급과 전문 교사진의 따뜻한 보살핌."}], levelsEyebrow:"생애 첫 배움", levelsTitle:"한빛에서의 배움", levels:[{t:"엄마와 아이",a:"10–18개월",href:"/enrichment/mother-toddler",cat:"baby,toddler,parent"},{t:"프리스쿨",a:"만 1.5–3세",href:"/about/milestones",cat:"preschool,toddler,children"},{t:"유치부",a:"만 3–6세",href:"/about/milestones",cat:"kindergarten,children,classroom"},{t:"방과후 · 특별활동",a:"전 연령",href:"/enrichment/afterschool",cat:"children,art,activity"}], numbersTitle:"숫자로 보는 한빛", locEyebrow:"서울 · 부산 · 대전 · 대구 · 광주", locTitle:"하나의 한빛,\n다섯 도시", visitTitle:"다음 단계: 방문 예약", visitBody:"캠퍼스 투어와 입학 설명회에서 한빛을 직접 만나보세요.", explore:"캠퍼스 보기", visit:"방문 예약" },
  en: { heroTitle:"Bringing English to Life", heroSub:"Kindergarten English programme · campuses in 5 cities", missionTitle:"We raise independent thinkers and future innovators — starting from a child's very first years of learning.", introEyebrow:"Our philosophy", introTitle:"Korea's leading\nEnglish kindergarten", introBody:"A strong English foundation is essential to unlocking a child's potential. In the kindergarten years, Hanbit immerses children in English through play with native-speaking teachers, growing curiosity and confidence in a natural English environment.", curriculum:"See the curriculum", diffEyebrow:"The Hanbit Difference", diffTitle:"Where English becomes\npart of every day", diff:[{t:"Native English immersion",d:"A natural, all-day environment where children communicate in English."},{t:"Play-based English",d:"Songs, play and stories make learning English a joy."},{t:"Whole-child development",d:"Alongside English, we nurture social skills, emotion and creativity."},{t:"Attentive care",d:"Small classes and specialist teachers, with warm, attentive care."}], levelsEyebrow:"A child's first learning", levelsTitle:"Learning at Hanbit", levels:[{t:"Mother & Toddler",a:"10–18 months",href:"/enrichment/mother-toddler",cat:"baby,toddler,parent"},{t:"Preschool",a:"Ages 1.5–3",href:"/about/milestones",cat:"preschool,toddler,children"},{t:"Kindergarten",a:"Ages 3–6",href:"/about/milestones",cat:"kindergarten,children,classroom"},{t:"Afterschool & enrichment",a:"All ages",href:"/enrichment/afterschool",cat:"children,art,activity"}], numbersTitle:"Hanbit by the Numbers", locEyebrow:"Seoul · Busan · Daejeon · Daegu · Gwangju", locTitle:"One Hanbit,\nFive Cities", visitTitle:"Next Steps: Schedule a Visit", visitBody:"Meet Hanbit in person on a campus tour or at an information session.", explore:"Explore campuses", visit:"Schedule a visit" }
}[locale];
const btnFill = "inline-block rounded-none bg-navy-900 px-8 py-4 text-xs font-semibold uppercase tracking-[0.18em] text-white transition hover:bg-navy-700";
const btnLine = "inline-block rounded-none border border-navy/40 px-8 py-4 text-xs font-semibold uppercase tracking-[0.18em] text-navy transition hover:bg-navy-900 hover:text-white hover:border-navy-900";
---
<section class="relative isolate flex min-h-[78vh] flex-col justify-center overflow-hidden bg-cream md:min-h-[88vh]">
  <video id="heroVid" autoplay muted playsinline poster={media.heroImage} src={media.heroVideos[0]} class="absolute inset-0 h-full w-full object-cover"></video>
  <div class="relative mx-auto w-full max-w-6xl px-6 py-20 md:py-28">
    <h1 class="reveal max-w-2xl whitespace-pre-line font-serif text-5xl font-semibold leading-[1.04] text-gold md:text-7xl">{c.heroTitle}</h1>
    <p class="reveal mt-6 text-base font-medium text-navy-900 md:whitespace-nowrap md:text-lg">{c.heroSub}</p>
    <div class="reveal mt-10 flex flex-wrap gap-4">
      <a href={p("/schools")} class={btnFill}>{c.explore}</a>
      <a href={p("/admissions")} class={btnFill}>{c.visit}</a>
    </div>
  </div>
  <div class="absolute inset-x-0 bottom-0 z-10"><CurvedDivider color="#f7f1e3" /></div>
</section>

<section class="relative overflow-hidden bg-cream"><Shapes class="opacity-90" /><div class="reveal relative mx-auto max-w-3xl px-6 pb-12 pt-2 text-center">
  <div class="rule-gold mx-auto mb-5"></div>
  <p class="font-serif text-3xl font-medium leading-snug text-navy-900 md:text-4xl">{c.missionTitle}</p>
</div></section>

<section class="bg-white">
  <div class="grid items-stretch md:grid-cols-2">
    <div class="reveal flex flex-col justify-center px-6 py-24 md:ml-auto md:max-w-xl md:py-32 md:pr-14">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">{c.introEyebrow}</p>
      <h2 class="mt-3 whitespace-pre-line font-serif text-4xl font-semibold leading-tight text-gold md:text-5xl">{c.introTitle}</h2>
      <div class="rule-gold my-7"></div>
      <p class="leading-relaxed text-ink/75">{c.introBody}</p>
      <a href={p("/about/milestones")} class={`mt-9 ${btnLine}`}>{c.curriculum}</a>
    </div>
    <Figure src="https://images.pexels.com/photos/8535163/pexels-photo-8535163.jpeg?auto=compress&cs=tinysrgb&w=900&h=1100&fit=crop" alt={locale === "en" ? "Children learning English" : "영어로 배우는 아이들"} class="min-h-[360px] md:min-h-full" rounded="rounded-none" />
  </div>
</section>

<section class="bg-navy-900 text-white"><div class="mx-auto grid max-w-6xl gap-12 px-6 py-24 md:grid-cols-2">
  <div class="reveal">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-soft">{c.diffEyebrow}</p>
    <h2 class="mt-3 whitespace-pre-line font-serif text-4xl font-semibold leading-tight md:text-5xl">{c.diffTitle}</h2>
  </div>
  <div data-reveal-children class="divide-y divide-white/15">
    {c.diff.map((d,i)=>(<div class="flex gap-6 py-6 first:pt-0"><span class="font-serif text-3xl font-semibold text-gold-soft">{String(i+1).padStart(2,"0")}</span><div><h3 class="font-serif text-2xl font-semibold">{d.t}</h3><p class="mt-2 text-sm leading-relaxed text-white/70">{d.d}</p></div></div>))}
  </div>
</div></section>



<section class="bg-cream"><div class="mx-auto max-w-6xl px-6 py-24">
  <p class="reveal font-serif text-3xl font-semibold text-navy-900">{c.numbersTitle}</p>
  <div data-reveal-children class="mt-12 grid grid-cols-2 gap-x-8 gap-y-12 md:grid-cols-4">
    {site.stats.map((s)=>(<div><p class="font-serif text-6xl font-semibold text-gold md:text-7xl"><span data-count-up={String(s.value)}>0</span>{s.suffix}</p><p class="mt-3 text-sm text-ink/65">{s.label}</p></div>))}
  </div>
</div></section>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<style is:global>
  #hbMap .leaflet-tile { filter: grayscale(1) brightness(1.05) sepia(1) hue-rotate(178deg) saturate(1.7) contrast(0.95); }
  #hbMap .leaflet-container { background: #e8f0fb; font: inherit; }
  .hb-pin { position: relative; width: 90px; height: 72px; display: flex; flex-direction: column; align-items: center; }
  .hb-pulse { position: absolute; left: 45px; top: 43px; width: 22px; height: 22px; border-radius: 9999px; background: #283566; transform: translate(-50%, -50%); animation: hbpulse 2.2s ease-out infinite; pointer-events: none; }
  @keyframes hbpulse { 0% { transform: translate(-50%,-50%) scale(0.4); opacity: 0.6; } 70% { opacity: 0; } 100% { transform: translate(-50%,-50%) scale(6); opacity: 0; } }
  .hb-pin-svg { animation: hbdrop 2.6s ease-in-out infinite; transform-origin: center bottom; }
  @keyframes hbdrop { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }
  .hb-pin-svg { filter: drop-shadow(0 2px 3px rgba(0,0,0,0.3)); }
  .hb-label { margin-top: 2px; white-space: nowrap; background: #283566; color: #fff; font-size: 12px; font-weight: 600; padding: 3px 9px; border-radius: 5px; box-shadow: 0 1px 5px rgba(0,0,0,0.25); }
  .hb-label-gold { background: #c9a227; color: #1f2a5e; }
  .hb-divicon { cursor: pointer; }
</style>
<section class="relative overflow-hidden bg-[#e8f0fb]">
  <div id="hbMap" class="h-[560px] w-full md:h-[660px]"></div>
  <div class="pointer-events-none absolute inset-0 z-[600]">
    <div class="mx-auto max-w-6xl px-6 pt-12 md:pt-16">
      <div class="max-w-md" style="text-shadow:0 1px 14px rgba(255,255,255,0.95),0 1px 3px rgba(255,255,255,0.95)">
        <h2 class="mt-3 whitespace-pre-line font-serif text-4xl font-semibold leading-tight text-navy-900 md:text-5xl">{c.locTitle}</h2>
        <a href={p("/schools")} style="text-shadow:none" class="pointer-events-auto mt-8 inline-block rounded-md bg-gold px-7 py-3.5 text-sm font-semibold uppercase tracking-wide text-white hover:brightness-95">{seeMap}</a>
      </div>
    </div>
  </div>
</section>
<script define:vars={{ pts: mapPts }}>
  (function () {
    function init() {
      if (!window.L) { return setTimeout(init, 60); }
      var map = L.map("hbMap", { scrollWheelZoom: false, zoomControl: false, dragging: false, doubleClickZoom: false, touchZoom: false, boxZoom: false, keyboard: false, attributionControl: true }).setView([36.4, 127.9], 7);
      map.getContainer().style.cursor = "default";
      L.tileLayer("https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png", { maxZoom: 19, subdomains: "abcd", attribution: '&copy; OpenStreetMap &copy; CARTO' }).addTo(map);
      pts.forEach(function (pt) {
        var gold = pt.flagship;
        var html = '<div class="hb-pin"><span class="hb-pulse"></span><svg class="hb-pin-svg" width="34" height="44" viewBox="0 0 24 32"><path d="M12 0C5.4 0 0 5.4 0 12c0 8.5 12 20 12 20s12-11.5 12-20C24 5.4 18.6 0 12 0z" fill="' + (gold ? "#c9a227" : "#283566") + '"/><circle cx="12" cy="12" r="4.5" fill="#fff"/></svg><span class="hb-label ' + (gold ? "hb-label-gold" : "") + '">' + pt.label + "</span></div>";
        var icon = L.divIcon({ className: "hb-divicon", html: html, iconSize: [90, 72], iconAnchor: [45, 44] });
        L.marker([pt.lat, pt.lng], { icon: icon }).addTo(map).on("click", function () { window.location.href = pt.href; });
      });
    }
    if (document.readyState !== "loading") init(); else document.addEventListener("DOMContentLoaded", init);
  })();
</script>


<script define:vars={{ vids: media.heroVideos }}>
  const v = document.getElementById("heroVid");
  if (v && Array.isArray(vids) && vids.length > 1) {
    let i = 0, timer;
    const play = () => { const p = v.play(); if (p && p.catch) p.catch(() => {}); };
    const next = () => { i = (i + 1) % vids.length; v.src = vids[i]; play(); schedule(); };
    const schedule = () => { clearTimeout(timer); timer = setTimeout(next, 10000); };
    v.addEventListener("ended", next);
    schedule();
  }
</script>
