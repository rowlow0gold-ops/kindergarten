---
import { useT, localizePath, type Locale } from "../../i18n/ui";
import Figure from "../Figure.astro";
import CurvedDivider from "../CurvedDivider.astro";
import Shapes from "../Shapes.astro";
import ScheduleArt from "../ScheduleArt.astro";
import siteKo from "../../data/site.json";
import siteEn from "../../data/en/site.json";
import branchesKo from "../../data/branches.json";
import branchesEn from "../../data/en/branches.json";
import media from "../../data/media.json";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useT(locale);
const p = (path: string) => localizePath(path, locale);
const site = locale === "en" ? siteEn : siteKo;
const branches = locale === "en" ? branchesEn : branchesKo;
const c = {
  ko: { heroTitle:"영어 학습을 삶으로", heroSub:"유치 영어 과정 · 전국 5개 도시 캠퍼스", missionTitle:"독립적으로 사고하고 더 나은 사회에 기여하는 미래의 혁신가를, 생애 첫 배움에서부터 키웁니다.", introEyebrow:"교육 철학", introTitle:"대한민국 대표\n국제 영어 유치원", introBody:"21세기 아이의 잠재력을 여는 데에는 탄탄한 영어 기초가 필수입니다. 한빛은 유치 시기에 원어민 교사와 함께 영어를 놀이로 익히며, 자연스러운 영어 환경 속에서 호기심과 자신감을 키웁니다.", curriculum:"교육과정 보기", diffEyebrow:"한빛의 차별점", diffTitle:"영어가 자연스러운\n일상이 되는 유치원", diff:[{t:"원어민 영어 몰입",d:"하루 종일 영어로 소통하는 자연스러운 몰입 환경."},{t:"놀이 중심 영어 학습",d:"노래, 놀이, 이야기로 영어를 즐겁게 익힙니다."},{t:"전인 교육",d:"영어와 함께 사회성, 정서, 창의력을 균형 있게."},{t:"세심한 돌봄",d:"소규모 학급과 전문 교사진의 따뜻한 보살핌."}], levelsEyebrow:"생애 첫 배움", levelsTitle:"한빛에서의 배움", levels:[{t:"엄마와 아이",a:"10–18개월",href:"/enrichment/mother-toddler",cat:"baby,toddler,parent"},{t:"프리스쿨",a:"만 1.5–3세",href:"/learning/preschool-kindergarten",cat:"preschool,toddler,children"},{t:"유치부",a:"만 3–6세",href:"/learning/preschool-kindergarten",cat:"kindergarten,children,classroom"},{t:"방과후 · 특별활동",a:"전 연령",href:"/enrichment/afterschool",cat:"children,art,activity"}], numbersTitle:"숫자로 보는 한빛", locEyebrow:"서울 · 부산 · 대전 · 대구 · 광주", locTitle:"하나의 한빛,\n다섯 도시", visitTitle:"다음 단계: 방문 예약", visitBody:"캠퍼스 투어와 입학 설명회에서 한빛을 직접 만나보세요.", explore:"캠퍼스 보기", visit:"방문 예약" },
  en: { heroTitle:"Bringing English to Life", heroSub:"Kindergarten English programme · campuses in 5 cities", missionTitle:"We raise independent thinkers and future innovators — starting from a child's very first years of learning.", introEyebrow:"Our philosophy", introTitle:"Korea's leading\nEnglish kindergarten", introBody:"A strong English foundation is essential to unlocking a child's potential. In the kindergarten years, Hanbit immerses children in English through play with native-speaking teachers, growing curiosity and confidence in a natural English environment.", curriculum:"See the curriculum", diffEyebrow:"The Hanbit Difference", diffTitle:"Where English becomes\npart of every day", diff:[{t:"Native English immersion",d:"A natural, all-day environment where children communicate in English."},{t:"Play-based English",d:"Songs, play and stories make learning English a joy."},{t:"Whole-child development",d:"Alongside English, we nurture social skills, emotion and creativity."},{t:"Attentive care",d:"Small classes and specialist teachers, with warm, attentive care."}], levelsEyebrow:"A child's first learning", levelsTitle:"Learning at Hanbit", levels:[{t:"Mother & Toddler",a:"10–18 months",href:"/enrichment/mother-toddler",cat:"baby,toddler,parent"},{t:"Preschool",a:"Ages 1.5–3",href:"/learning/preschool-kindergarten",cat:"preschool,toddler,children"},{t:"Kindergarten",a:"Ages 3–6",href:"/learning/preschool-kindergarten",cat:"kindergarten,children,classroom"},{t:"Afterschool & enrichment",a:"All ages",href:"/enrichment/afterschool",cat:"children,art,activity"}], numbersTitle:"Hanbit by the Numbers", locEyebrow:"Seoul · Busan · Daejeon · Daegu · Gwangju", locTitle:"One Hanbit,\nFive Cities", visitTitle:"Next Steps: Schedule a Visit", visitBody:"Meet Hanbit in person on a campus tour or at an information session.", explore:"Explore campuses", visit:"Schedule a visit" }
}[locale];
const btnFill = "inline-block rounded-none bg-navy-900 px-8 py-4 text-xs font-semibold uppercase tracking-[0.18em] text-white transition hover:bg-navy-700";
const btnLine = "inline-block rounded-none border border-navy/40 px-8 py-4 text-xs font-semibold uppercase tracking-[0.18em] text-navy transition hover:bg-navy-900 hover:text-white hover:border-navy-900";
---
<section class="relative isolate overflow-hidden bg-cream">
  <video id="heroVid" autoplay muted playsinline poster={media.heroImage} src={media.heroVideos[0]} class="absolute inset-0 h-full w-full object-cover"></video>
  <div class="relative mx-auto max-w-6xl px-6 py-36 md:py-52">
    <h1 class="reveal max-w-2xl whitespace-pre-line font-serif text-5xl font-semibold leading-[1.04] text-gold md:text-7xl">{c.heroTitle}</h1>
    <p class="reveal mt-6 text-base font-medium text-navy-900 md:whitespace-nowrap md:text-lg">{c.heroSub}</p>
    <div class="reveal mt-10 flex flex-wrap gap-4">
      <a href={p("/schools")} class={btnFill}>{c.explore}</a>
      <a href={p("/admissions")} class={btnLine}>{c.visit}</a>
    </div>
  </div>
  <div class="relative"><CurvedDivider color="#f7f1e3" /></div>
</section>

<section class="relative overflow-hidden bg-cream"><Shapes class="opacity-90" /><div class="reveal relative mx-auto max-w-3xl px-6 pb-24 pt-4 text-center">
  <div class="rule-gold mx-auto mb-8"></div>
  <p class="font-serif text-3xl font-medium leading-snug text-navy-900 md:text-4xl">{c.missionTitle}</p>
</div></section>

<section class="bg-white">
  <div class="grid items-stretch md:grid-cols-2">
    <div class="reveal flex flex-col justify-center px-6 py-24 md:ml-auto md:max-w-xl md:py-32 md:pr-14">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">{c.introEyebrow}</p>
      <h2 class="mt-3 whitespace-pre-line font-serif text-4xl font-semibold leading-tight text-gold md:text-5xl">{c.introTitle}</h2>
      <div class="rule-gold my-7"></div>
      <p class="leading-relaxed text-ink/75">{c.introBody}</p>
      <a href={p("/learning")} class={`mt-9 ${btnLine}`}>{c.curriculum}</a>
    </div>
    <Figure alt={locale === "en" ? "Children learning English" : "영어로 배우는 아이들"} cat="kindergarten,children" class="min-h-[360px] md:min-h-full" rounded="rounded-none" />
  </div>
</section>

<section class="bg-navy-900 text-white"><div class="mx-auto grid max-w-6xl gap-12 px-6 py-24 md:grid-cols-2">
  <div class="reveal">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-soft">{c.diffEyebrow}</p>
    <h2 class="mt-3 whitespace-pre-line font-serif text-4xl font-semibold leading-tight md:text-5xl">{c.diffTitle}</h2>
  </div>
  <div data-reveal-children class="divide-y divide-white/15">
    {c.diff.map((d,i)=>(<div class="flex gap-6 py-6 first:pt-0"><span class="font-serif text-3xl font-semibold text-gold-soft">{String(i+1).padStart(2,"0")}</span><div><h3 class="font-serif text-2xl font-semibold">{d.t}</h3><p class="mt-2 text-sm leading-relaxed text-white/70">{d.d}</p></div></div>))}
  </div>
</div></section>



<section class="bg-cream"><div class="mx-auto max-w-6xl px-6 py-24">
  <p class="reveal font-serif text-3xl font-semibold text-navy-900">{c.numbersTitle}</p>
  <div data-reveal-children class="mt-12 grid grid-cols-2 gap-x-8 gap-y-12 md:grid-cols-4">
    {site.stats.map((s)=>(<div><p class="font-serif text-6xl font-semibold text-gold md:text-7xl"><span data-count-up={String(s.value)}>0</span>{s.suffix}</p><p class="mt-3 text-sm text-ink/65">{s.label}</p></div>))}
  </div>
</div></section>

<section class="relative overflow-hidden bg-white"><div class="mx-auto max-w-6xl px-6 py-24">
  <div class="reveal mx-auto max-w-2xl text-center">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-navy/60">{c.locEyebrow}</p>
    <h2 class="mt-3 whitespace-pre-line font-serif text-4xl font-semibold leading-tight text-navy-900 md:text-5xl">{c.locTitle}</h2>
  </div>
  <div data-reveal-children class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {branches.map((b,i)=>(
      <a href={p(`/schools/${b.slug}`)} class="group relative block overflow-hidden rounded-3xl shadow-sm ring-1 ring-black/5 transition duration-300 hover:-translate-y-1 hover:shadow-xl">
        <div class="relative aspect-[4/3] overflow-hidden">
          <Figure alt={b.name} cat="korea,city,architecture" class="absolute inset-0 h-full w-full transition duration-700 group-hover:scale-110" rounded="rounded-none" />
          <div class="absolute inset-0 bg-gradient-to-t from-navy-900 via-navy-900/35 to-transparent"></div>
        </div>
        <span class="absolute left-5 top-5 grid h-9 w-9 place-items-center rounded-full bg-gold font-serif text-sm font-semibold text-navy-900 shadow">{i+1}</span>
        <span class="absolute right-5 top-5 text-lg text-white/0 transition group-hover:translate-x-0.5 group-hover:text-white">→</span>
        <div class="absolute inset-x-0 bottom-0 p-5 text-white">
          <h3 class="font-serif text-xl font-semibold">{b.name}</h3>
          <p class="mt-0.5 text-sm text-white/75">{b.city} · {locale === "en" ? "Ages 3–6" : "만 3–6세"}</p>
        </div>
      </a>
    ))}
  </div>
</div></section>

<section class="bg-cream"><div class="mx-auto grid max-w-6xl items-center gap-12 px-6 py-24 md:grid-cols-2">
  <div class="reveal flex justify-center"><ScheduleArt class="w-full max-w-sm" /></div>
  <div class="reveal">
    <div class="rule-gold mb-8"></div>
    <h2 class="font-serif text-4xl font-semibold text-navy-900 md:text-5xl">{c.visitTitle}</h2>
    <p class="mt-5 max-w-lg text-ink/70">{c.visitBody}</p>
    <a href={p("/contact")} class="mt-9 inline-block rounded-none bg-gold px-8 py-4 text-xs font-semibold uppercase tracking-[0.18em] text-navy-900 transition hover:brightness-95">{c.visit}</a>
  </div>
</div></section>

<script define:vars={{ vids: media.heroVideos }}>
  const v = document.getElementById("heroVid");
  if (v && Array.isArray(vids) && vids.length > 1) {
    let i = 0, timer;
    const play = () => { const p = v.play(); if (p && p.catch) p.catch(() => {}); };
    const next = () => { i = (i + 1) % vids.length; v.src = vids[i]; play(); schedule(); };
    const schedule = () => { clearTimeout(timer); timer = setTimeout(next, 10000); };
    v.addEventListener("ended", next);
    schedule();
  }
</script>
