---
import Figure from "../Figure.astro";
import { localizePath, type Locale } from "../../i18n/ui";
import brKo from "../../data/branches.json";
import brEn from "../../data/en/branches.json";
import media from "../../data/media.json";
const campusImages: Record<string, string> = (media as any).campusImages || {};
interface Props { locale: Locale; }
const { locale } = Astro.props;
const en = locale === "en";
const p = (path: string) => localizePath(path, locale);
const branches = en ? brEn : brKo;

const c = en
  ? { eyebrow: "Seoul · Busan · Daejeon · Daegu · Gwangju", title: "Our Campuses", sub: "Choose a city to see campus details, shuttle routes and enrichment programs.", filter: "Find your campus", info: "Campus information", shuttle: "Shuttle bus", after: "Afterschool", sat: "Saturday School", camp: "Seasonal Camp", none: "Not offered at this campus", fAddr: "Address", fPhone: "Phone", fHours: "Hours", fAccess: "Getting here", fAges: "Ages", choose: "Choose your campus", chooseSub: "Pick a city above to see its details, shuttle routes and programs." }
  : { eyebrow: "서울 · 부산 · 대전 · 대구 · 광주", title: "캠퍼스 안내", sub: "도시를 선택하면 캠퍼스 정보, 통학 차량, 특별활동을 확인할 수 있습니다.", filter: "캠퍼스 선택", info: "캠퍼스 정보", shuttle: "통학 차량", after: "방과후", sat: "토요학교", camp: "계절 캠프", none: "이 캠퍼스에서는 운영하지 않습니다", fAddr: "주소", fPhone: "전화", fHours: "운영 시간", fAccess: "오시는 길", fAges: "연령", choose: "캠퍼스를 선택해 주세요", chooseSub: "위에서 도시를 선택하면 정보, 통학 차량, 프로그램이 표시됩니다." };

const avail: Record<string, { sat: boolean; camp: boolean }> = {
  "seoul-gangnam": { sat: true, camp: true }, "busan-haeundae": { sat: true, camp: true },
  "daejeon-yuseong": { sat: true, camp: true }, "daegu-suseong": { sat: false, camp: false },
  "gwangju-namgu": { sat: true, camp: true },
};
const enr = en ? {
  after: [
    { t: "Ballet", time: "Tue · 15:30–16:30", price: "₩90,000 / mo" },
    { t: "Dance & Performing Arts", time: "Thu · 15:30–16:30", price: "₩90,000 / mo" },
    { t: "Art Studio", time: "Mon · 15:30–16:30", price: "₩80,000 / mo" },
    { t: "Music & Piano", time: "Wed · 15:30–16:30", price: "₩100,000 / mo" },
    { t: "Physical Education", time: "Fri · 15:30–16:30", price: "₩70,000 / mo" },
    { t: "English Plus", time: "Mon, Wed · 16:30–17:30", price: "₩120,000 / mo" },
    { t: "Story & Drama", time: "Tue, Thu · 16:30–17:30", price: "₩90,000 / mo" },
    { t: "Soccer & Ball Sports", time: "Fri · 16:00–17:00", price: "₩75,000 / mo" },
  ],
  sat: [
    { t: "Saturday English", time: "Sat · 10:00–12:00", price: "₩160,000 / mo" },
    { t: "Weekend Art & Play", time: "Sat · 13:00–15:00", price: "₩140,000 / mo" },
  ],
  camp: [
    { t: "Summer English Camp", time: "Daily · 09:00–15:00", price: "₩450,000 / 4 wks" },
    { t: "Winter English Camp", time: "Daily · 09:00–14:00", price: "₩350,000 / 3 wks" },
  ],
} : {
  after: [
    { t: "발레", time: "화 · 15:30–16:30", price: "월 90,000원" },
    { t: "무용 · 공연 예술", time: "목 · 15:30–16:30", price: "월 90,000원" },
    { t: "아트 스튜디오", time: "월 · 15:30–16:30", price: "월 80,000원" },
    { t: "음악 · 피아노", time: "수 · 15:30–16:30", price: "월 100,000원" },
    { t: "체육", time: "금 · 15:30–16:30", price: "월 70,000원" },
    { t: "영어 플러스", time: "월, 수 · 16:30–17:30", price: "월 120,000원" },
    { t: "스토리 · 드라마", time: "화, 목 · 16:30–17:30", price: "월 90,000원" },
    { t: "축구 · 볼 스포츠", time: "금 · 16:00–17:00", price: "월 75,000원" },
  ],
  sat: [
    { t: "토요 영어", time: "토 · 10:00–12:00", price: "월 160,000원" },
    { t: "주말 아트 · 놀이", time: "토 · 13:00–15:00", price: "월 140,000원" },
  ],
  camp: [
    { t: "여름 영어 캠프", time: "매일 · 09:00–15:00", price: "450,000원 (4주)" },
    { t: "겨울 영어 캠프", time: "매일 · 09:00–14:00", price: "350,000원 (3주)" },
  ],
};
const rows = (list: any[]) => list;
---
<section class="bg-navy-900 text-white"><div class="reveal mx-auto max-w-6xl px-6 py-20 text-center">
  <p class="text-sm font-semibold uppercase tracking-wide text-gold">{c.eyebrow}</p>
  <h1 class="mt-2 font-serif text-4xl font-semibold md:text-5xl">{c.title}</h1>
  <p class="mx-auto mt-4 max-w-xl text-white/70">{c.sub}</p>
</div></section>

<section class="bg-cream"><div class="mx-auto max-w-6xl px-6 py-16">
  <div class="reveal mb-12">
    <p class="mb-3 text-xs font-semibold uppercase tracking-[0.15em] text-ink/45">{c.filter}</p>
    <div class="flex flex-wrap gap-2">
      {branches.map((b: any) => (<button data-city={b.slug} class="rounded-full px-5 py-2 text-sm font-semibold transition">{b.city}</button>))}
    </div>
  </div>

  {branches.map((b: any) => (
    <div data-campus-block={b.slug} style="display:none" class="space-y-12">
      <div class="grid items-start gap-8 md:grid-cols-2">
        <div class="overflow-hidden rounded-3xl shadow-sm ring-1 ring-black/5"><Figure src={campusImages[b.slug]} alt={b.name} class="aspect-[4/3]" rounded="rounded-none" /></div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-gold">{b.city}</p>
          <h2 class="mt-1 font-serif text-3xl font-semibold text-navy-900 md:text-4xl">{b.name}</h2>
          <p class="mt-3 leading-relaxed text-ink/70">{b.intro}</p>
          <dl class="mt-6 space-y-2.5 text-sm">
            <div class="flex gap-3"><dt class="w-24 shrink-0 font-semibold text-navy-900">{c.fAddr}</dt><dd class="text-ink/75">{b.address}</dd></div>
            <div class="flex gap-3"><dt class="w-24 shrink-0 font-semibold text-navy-900">{c.fPhone}</dt><dd class="text-ink/75">{b.phone}</dd></div>
            <div class="flex gap-3"><dt class="w-24 shrink-0 font-semibold text-navy-900">{c.fHours}</dt><dd class="text-ink/75">{b.hours}</dd></div>
            <div class="flex gap-3"><dt class="w-24 shrink-0 font-semibold text-navy-900">{c.fAccess}</dt><dd class="text-ink/75">{b.access}</dd></div>
            <div class="flex gap-3"><dt class="w-24 shrink-0 font-semibold text-navy-900">{c.fAges}</dt><dd class="text-ink/75">{b.ages}</dd></div>
          </dl>
        </div>
      </div>

      <div class="rounded-2xl bg-white p-6 ring-1 ring-black/5">
        <h3 class="flex items-center gap-2 font-serif text-xl font-semibold text-navy-900">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-gold"><path d="M4 16V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v10"/><path d="M3 16h18"/><circle cx="7.5" cy="18.5" r="1.5"/><circle cx="16.5" cy="18.5" r="1.5"/><path d="M6 8h12"/></svg>
          {c.shuttle}
        </h3>
        <ul class="mt-4 space-y-2 text-sm text-ink/75">
          {b.shuttle.map((r: string) => (<li class="flex gap-2"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold"></span>{r}</li>))}
        </ul>
      </div>

      <div class="grid gap-6 lg:grid-cols-3">
        <div class="rounded-2xl bg-white p-6 ring-1 ring-black/5">
          <h3 class="font-serif text-lg font-semibold text-navy-900">{c.after}</h3>
          <div class="mt-4 divide-y divide-black/5">
            {rows(enr.after).map((pr: any) => (
              <div class="py-2.5"><p class="font-medium text-navy-900">{pr.t}</p><p class="mt-0.5 text-xs text-ink/55">{pr.time}</p></div>
            ))}
          </div>
        </div>
        <div class="rounded-2xl bg-white p-6 ring-1 ring-black/5">
          <h3 class="font-serif text-lg font-semibold text-navy-900">{c.sat}</h3>
          {avail[b.slug]?.sat ? (
            <div class="mt-4 divide-y divide-black/5">
              {rows(enr.sat).map((pr: any) => (
                <div class="py-2.5"><p class="font-medium text-navy-900">{pr.t}</p><p class="mt-0.5 text-xs text-ink/55">{pr.time}</p></div>
              ))}
            </div>
          ) : (<p class="mt-4 text-sm text-ink/45">{c.none}</p>)}
        </div>
        <div class="rounded-2xl bg-white p-6 ring-1 ring-black/5">
          <h3 class="font-serif text-lg font-semibold text-navy-900">{c.camp}</h3>
          {avail[b.slug]?.camp ? (
            <div class="mt-4 divide-y divide-black/5">
              {rows(enr.camp).map((pr: any) => (
                <div class="py-2.5"><p class="font-medium text-navy-900">{pr.t}</p><p class="mt-0.5 text-xs text-ink/55">{pr.time}</p></div>
              ))}
            </div>
          ) : (<p class="mt-4 text-sm text-ink/45">{c.none}</p>)}
        </div>
      </div>
    </div>
  ))}
  <div data-empty class="rounded-3xl border border-dashed border-navy/20 bg-white/50 py-20 text-center">
    <svg class="mx-auto h-12 w-12 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 21s-7-5.2-7-11a7 7 0 1 1 14 0c0 5.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.4"/></svg>
    <p class="mt-4 font-serif text-2xl font-semibold text-navy-900">{c.choose}</p>
    <p class="mx-auto mt-2 max-w-sm text-sm text-ink/55">{c.chooseSub}</p>
  </div>
</div></section>
<script is:inline>
(function () {
  var blocks = Array.prototype.slice.call(document.querySelectorAll("[data-campus-block]"));
  var pills = Array.prototype.slice.call(document.querySelectorAll("[data-city]"));
  var prompt = document.querySelector("[data-empty]");
  var sel = null;
  function render() {
    blocks.forEach(function (b) { b.style.display = b.getAttribute("data-campus-block") === sel ? "" : "none"; });
    if (prompt) prompt.style.display = sel ? "none" : "";
    pills.forEach(function (p) {
      var on = p.getAttribute("data-city") === sel;
      p.className = "rounded-full px-5 py-2 text-sm font-semibold transition " + (on ? "bg-navy text-white" : "bg-cream text-navy ring-1 ring-black/5 hover:bg-navy/10");
    });
  }
  pills.forEach(function (p) { p.onclick = function () { sel = p.getAttribute("data-city"); render(); }; });
  render();
})();
</script>
