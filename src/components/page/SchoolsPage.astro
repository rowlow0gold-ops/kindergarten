---
import { useT, localizePath, type Locale } from "../../i18n/ui";
import Figure from "../Figure.astro";
import branchesKo from "../../data/branches.json";
import branchesEn from "../../data/en/branches.json";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useT(locale);
const p = (path: string) => localizePath(path, locale);
const branches = locale === "en" ? branchesEn : branchesKo;
const c = {
  ko: { eyebrow: "서울 · 부산 · 대전 · 대구 · 광주", title: "하나의 한빛, 다섯 도시", sub: "전국 캠퍼스에서 같은 교육 철학을 만나보세요." },
  en: { eyebrow: "Seoul · Busan · Daejeon · Daegu · Gwangju", title: "One Hanbit, Five Cities", sub: "Find the same philosophy across our campuses nationwide." },
}[locale];
---
<section class="bg-navy-900 text-white">
  <div class="reveal mx-auto max-w-6xl px-5 py-20 text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-gold">{c.eyebrow}</p>
    <h1 class="mt-2 font-serif text-4xl font-semibold md:text-5xl">{c.title}</h1>
    <p class="mx-auto mt-4 max-w-xl text-white/70">{c.sub}</p>
  </div>
</section>
<section class="bg-cream">
  <div class="mx-auto max-w-6xl px-5 py-16">
    <Figure alt={locale === "en" ? "Campus map of Korea" : "전국 캠퍼스 지도"} class="reveal aspect-[16/7]" />
    <div data-reveal-children class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {branches.map((b) => (
        <a href={p(`/schools/${b.slug}`)} class="group overflow-hidden rounded-2xl bg-white shadow-sm transition hover:shadow-md">
          <Figure alt={b.name} class="aspect-[4/3]" rounded="rounded-none" />
          <div class="p-6">
            <p class="text-xs font-semibold uppercase tracking-wide text-gold">{b.city}{b.flagship ? " · ★" : ""}</p>
            <h2 class="mt-1 font-serif text-xl font-semibold text-navy-900 group-hover:text-navy">{b.name}</h2>
            <p class="mt-2 text-sm text-ink/70">{b.levels}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
