---
import { localizePath, type Locale } from "../../i18n/ui";
interface Props { locale: Locale; item: any; }
const { locale, item } = Astro.props;
const p = (path: string) => localizePath(path, locale);
const back = locale === "en" ? "← All news" : "← 소식 전체보기";
const contact = locale === "en" ? "Contact us" : "문의하기";
const paras = String(item.body || "").split("\n").map((x) => x.trim()).filter(Boolean);
---
<section class="bg-navy-900 text-white"><div class="mx-auto max-w-3xl px-6 py-16">
  <a href={p("/news")} class="text-sm text-white/70 transition hover:text-gold-soft">{back}</a>
  <div class="reveal mt-6 flex items-center gap-3 text-xs"><span class="rounded-full bg-white/10 px-2.5 py-1 font-semibold text-gold-soft">{item.category}</span><time class="text-white/60">{item.date}</time></div>
  <h1 class="reveal mt-2 font-serif text-3xl font-semibold leading-tight md:text-4xl">{item.title}</h1>
</div></section>

<section class="bg-white">
  <article class="reveal mx-auto max-w-2xl px-6 py-16">
    <div class="rule-gold mb-8"></div>
    {paras.map((para, i) => (
      <p class={i === 0 ? "font-serif text-xl leading-relaxed text-ink/85 md:text-2xl" : "mt-6 text-lg leading-relaxed text-ink/75"}>{para}</p>
    ))}
    <div class="mt-14 flex flex-wrap items-center justify-between gap-4 border-t border-black/10 pt-8">
      <a href={p("/news")} class="text-sm font-semibold text-navy transition hover:text-gold">{back}</a>
      <a href={p("/contact")} class="rounded-full bg-navy px-6 py-3 text-sm font-semibold text-white transition hover:bg-navy-900">{contact}</a>
    </div>
  </article>
</section>
