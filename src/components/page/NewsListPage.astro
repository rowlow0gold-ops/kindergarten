---
import { localizePath, type Locale } from "../../i18n/ui";
import newsKo from "../../data/news.json";
import newsEn from "../../data/en/news.json";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const p = (path: string) => localizePath(path, locale);
const items = (locale === "en" ? newsEn : newsKo).slice().sort((a,b)=>b.date.localeCompare(a.date));
const title = locale === "en" ? "News & Notices" : "소식 · 공지";
---
<section class="bg-navy-900 text-white"><div class="reveal mx-auto max-w-6xl px-5 py-20"><h1 class="font-serif text-4xl font-semibold md:text-5xl">{title}</h1></div></section>
<section class="bg-white"><div class="mx-auto max-w-4xl px-5 py-16">
  <ul data-reveal-children class="divide-y divide-black/5">
    {items.map((n)=>(
      <li class="py-6">
        <a href={p(`/news/${n.slug}`)} class="group block">
          <div class="flex items-center gap-3 text-xs"><span class="rounded-full bg-cream px-2.5 py-1 font-semibold text-navy">{n.category}</span><time class="text-ink/50">{n.date}</time></div>
          <h2 class="mt-2 font-serif text-xl font-semibold text-navy-900 group-hover:text-navy">{n.title}</h2>
          <p class="mt-1 text-sm text-ink/70">{n.excerpt}</p>
        </a>
      </li>
    ))}
  </ul>
</div></section>
