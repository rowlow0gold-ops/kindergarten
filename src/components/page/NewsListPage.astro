---
import Figure from "../Figure.astro";
import { localizePath, type Locale } from "../../i18n/ui";
import newsKo from "../../data/news.json";
import newsEn from "../../data/en/news.json";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const p = (path: string) => localizePath(path, locale);
const all = (locale === "en" ? newsEn : newsKo).slice().sort((a, b) => b.date.localeCompare(a.date));
const noticeCats = locale === "en" ? ["Notice"] : ["공지"];
const notices = all.filter((n) => noticeCats.includes(n.category));
const newsAll = all.filter((n) => !noticeCats.includes(n.category));
const featured = newsAll[0];
const news = newsAll.slice(1);
const title = locale === "en" ? "News & Notices" : "뉴스 · 공지";
const newsLabel = locale === "en" ? "News" : "뉴스";
const noticeLabel = locale === "en" ? "Notices" : "공지";
const featuredLabel = locale === "en" ? "Latest" : "최신 소식";
const readMore = locale === "en" ? "Read more" : "자세히 보기";
const moreLabel = locale === "en" ? "Show more" : "더 보기";
const chipMap: Record<string, string> = {
  "공지": "bg-sky-100 text-sky-700", "Notice": "bg-sky-100 text-sky-700",
  "행사": "bg-amber-100 text-amber-700", "Events": "bg-amber-100 text-amber-700",
  "교육": "bg-teal-100 text-teal-700", "Learning": "bg-teal-100 text-teal-700",
  "입학": "bg-rose-100 text-rose-700", "Admissions": "bg-rose-100 text-rose-700",
};
const chip = (c: string) => chipMap[c] ?? "bg-cream text-navy";
---
<section class="bg-navy-900 text-white"><div class="reveal mx-auto max-w-6xl px-6 py-20 text-center"><h1 class="font-serif text-5xl font-semibold md:text-6xl">{title}</h1></div></section>
<section class="bg-white"><div class="mx-auto max-w-6xl px-6 py-16">

  {featured && (
    <a href={p(`/news/${featured.slug}`)} class="reveal group mb-14 grid overflow-hidden rounded-3xl bg-cream shadow-sm transition hover:shadow-md md:grid-cols-2">
      <div class="relative aspect-[16/10] overflow-hidden md:aspect-auto">
        <Figure alt={featured.title} class="absolute inset-0 h-full w-full transition duration-700 group-hover:scale-105" rounded="rounded-none" />
      </div>
      <div class="flex flex-col justify-center p-8 md:p-10">
        <div class="flex items-center gap-3 text-xs">
          <span class="rounded-full bg-gold/15 px-3 py-1 font-semibold uppercase tracking-wide text-navy">{featuredLabel}</span>
          <span class={`rounded-full px-2.5 py-1 font-semibold ${chip(featured.category)}`}>{featured.category}</span>
          <time class="text-ink/50">{featured.date}</time>
        </div>
        <h2 class="mt-4 font-serif text-2xl font-semibold leading-snug text-navy-900 md:text-3xl">{featured.title}</h2>
        <p class="mt-3 line-clamp-3 text-ink/70">{featured.excerpt}</p>
        <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-navy group-hover:gap-2.5 transition-all">{readMore}<span aria-hidden="true">→</span></span>
      </div>
    </a>
  )}

  <div class="grid items-stretch gap-12 lg:grid-cols-2">
    <div class="flex flex-col">
      <div class="rule-gold mb-5"></div>
      <h2 class="font-serif text-2xl font-semibold text-navy-900 md:text-3xl">{newsLabel}</h2>
      <ul data-list="news" class="mt-6 divide-y divide-black/5">
        {news.map((n) => (
          <li><a href={p(`/news/${n.slug}`)} class="group flex h-[7.5rem] items-center gap-4 py-2">
            <div class="relative h-[6rem] w-[6rem] shrink-0 overflow-hidden rounded-2xl">
              <Figure alt={n.title} class="absolute inset-0 h-full w-full transition duration-500 group-hover:scale-110" rounded="rounded-none" />
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2 text-xs"><span class={`rounded-full px-2.5 py-1 font-semibold ${chip(n.category)}`}>{n.category}</span><time class="text-ink/50">{n.date}</time></div>
              <h3 class="mt-1.5 line-clamp-1 font-serif text-lg font-semibold text-navy-900 group-hover:text-navy">{n.title}</h3>
              <p class="mt-1 line-clamp-2 text-sm text-ink/70">{n.excerpt}</p>
            </div>
          </a></li>
        ))}
      </ul>
      <div data-more="news" class="mt-7 flex justify-center">
        <button class="inline-flex items-center gap-2 rounded-full bg-cream px-6 py-2.5 text-sm font-semibold text-navy ring-1 ring-black/5 transition hover:bg-navy hover:text-white"><span class="-mt-1 text-lg leading-none tracking-widest">···</span><span>{moreLabel}</span></button>
      </div>
    </div>

    <div class="flex flex-col">
      <div class="rule-gold mb-5"></div>
      <h2 class="font-serif text-2xl font-semibold text-navy-900 md:text-3xl">{noticeLabel}</h2>
      <ul data-list="notices" class="mt-6 space-y-3">
        {notices.map((n) => (
          <li><a href={p(`/news/${n.slug}`)} class="group flex h-[6.75rem] items-center gap-4 rounded-2xl bg-cream/50 px-4 ring-1 ring-black/5 transition hover:bg-cream hover:ring-navy/15">
            <span class={`grid h-11 w-11 shrink-0 place-items-center rounded-xl ${chip(n.category)}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            </span>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2 text-xs"><span class={`rounded-full px-2.5 py-1 font-semibold ${chip(n.category)}`}>{n.category}</span><time class="text-ink/50">{n.date}</time></div>
              <h3 class="mt-1 line-clamp-1 font-serif text-base font-semibold text-navy-900 group-hover:text-navy">{n.title}</h3>
              <p class="mt-0.5 line-clamp-1 text-sm text-ink/70">{n.excerpt}</p>
            </div>
          </a></li>
        ))}
      </ul>
      <div data-more="notices" class="mt-7 flex justify-center">
        <button class="inline-flex items-center gap-2 rounded-full bg-cream px-6 py-2.5 text-sm font-semibold text-navy ring-1 ring-black/5 transition hover:bg-navy hover:text-white"><span class="-mt-1 text-lg leading-none tracking-widest">···</span><span>{moreLabel}</span></button>
      </div>
    </div>
  </div>
</div></section>
<script is:inline>
(function () {
  var STEP = 4;
  document.querySelectorAll("[data-list]").forEach(function (list) {
    var key = list.getAttribute("data-list");
    var items = Array.prototype.slice.call(list.children);
    var wrap = document.querySelector([data-more=' + key + ']);
    var btn = wrap ? wrap.querySelector("button") : null;
    var shown = STEP;
    function render() {
      items.forEach(function (el, i) { el.style.display = i < shown ? "" : "none"; });
      if (wrap) wrap.style.display = shown >= items.length ? "none" : "flex";
    }
    if (btn) btn.onclick = function () { shown += STEP; render(); };
    render();
  });
})();
</script>
