---
import { localizePath, type Locale } from "../../i18n/ui";
import newsKo from "../../data/news.json";
import newsEn from "../../data/en/news.json";
import evKo from "../../data/events.json";
import evEn from "../../data/en/events.json";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const p = (path: string) => localizePath(path, locale);
const items = (locale === "en" ? newsEn : newsKo).slice().sort((a, b) => b.date.localeCompare(a.date));
const events = (locale === "en" ? evEn : evKo).slice().sort((a, b) => a.date.localeCompare(b.date));
const title = locale === "en" ? "News & Events" : "소식 · 행사";
const newsTitle = locale === "en" ? "News & Notices" : "뉴스 · 공지";
const evTitle = locale === "en" ? "Visits & Info Sessions" : "행사 · 설명회";
---
<section class="bg-navy-900 text-white"><div class="reveal mx-auto max-w-6xl px-6 py-20 text-center"><h1 class="font-serif text-5xl font-semibold md:text-6xl">{title}</h1></div></section>
<section class="bg-white"><div class="mx-auto max-w-4xl px-6 py-16">
  <div class="rule-gold mb-6"></div>
  <h2 class="reveal font-serif text-3xl font-semibold text-navy-900 md:text-4xl">{newsTitle}</h2>
  <ul data-reveal-children class="mt-8 divide-y divide-black/5">
    {items.map((n) => (
      <li class="py-6"><a href={p(`/news/${n.slug}`)} class="group block">
        <div class="flex items-center gap-3 text-xs"><span class="rounded-full bg-cream px-2.5 py-1 font-semibold text-navy">{n.category}</span><time class="text-ink/50">{n.date}</time></div>
        <h3 class="mt-2 font-serif text-xl font-semibold text-navy-900 group-hover:text-navy">{n.title}</h3>
        <p class="mt-1 text-sm text-ink/70">{n.excerpt}</p>
      </a></li>
    ))}
  </ul>
</div></section>
<section class="bg-cream"><div class="mx-auto max-w-4xl px-6 py-16">
  <div class="rule-gold mb-6"></div>
  <h2 class="reveal font-serif text-3xl font-semibold text-navy-900 md:text-4xl">{evTitle}</h2>
  <div data-reveal-children class="mt-8 grid gap-5 sm:grid-cols-2">
    {events.map((e) => (
      <a href={p(`/events/${e.slug}`)} class="group rounded-2xl bg-white p-6 shadow-sm transition hover:shadow-md">
        <div class="flex items-center gap-3 text-xs"><span class="rounded-full bg-cream px-2.5 py-1 font-semibold text-navy">{e.category}</span><time class="text-ink/50">{e.date}</time></div>
        <h3 class="mt-2 font-serif text-lg font-semibold text-navy-900 group-hover:text-navy">{e.title}</h3>
        <p class="mt-1 text-sm text-ink/70">{e.time} · {e.location}</p>
      </a>
    ))}
  </div>
</div></section>
