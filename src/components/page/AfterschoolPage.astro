---
import Figure from "../Figure.astro";
import { localizePath, type Locale } from "../../i18n/ui";
import brKo from "../../data/branches.json";
import brEn from "../../data/en/branches.json";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const en = locale === "en";
const p = (path: string) => localizePath(path, locale);
const branches = en ? brEn : brKo;

const eyebrow = en ? "Enrichment" : "방과후 · 특별";
const title = en ? "Enrichment Programs" : "방과후 · 특별 프로그램";
const intro = en
  ? "Beyond the school day, Hanbit offers weekday afterschool activities, weekend Saturday School and seasonal holiday camps — joyful, hands-on learning led by specialist and native teachers."
  : "정규 일과를 마친 뒤에도 한빛은 평일 방과후 활동, 주말 토요학교, 방학 계절 캠프를 운영합니다. 전문 강사와 원어민 교사가 이끄는 즐겁고 직접적인 배움입니다.";

const groups = en ? [
  { title: "Afterschool", sub: "Weekday enrichment after the school day · monthly", cat: "afterschool,children,activity", programs: [
    { seed: "ballet", t: "Ballet", d: "Posture, balance, flexibility and rhythm.", time: "Tue · 15:30–16:30", price: "₩90,000 / month" },
    { seed: "dance", t: "Dance & Performing Arts", d: "Imagination, expression and stage confidence.", time: "Thu · 15:30–16:30", price: "₩90,000 / month" },
    { seed: "art", t: "Art Studio", d: "Painting, drawing and crafts to grow creativity.", time: "Mon · 15:30–16:30", price: "₩80,000 / month" },
    { seed: "music", t: "Music & Piano", d: "Melodies and percussion with the colored-note method.", time: "Wed · 15:30–16:30", price: "₩100,000 / month" },
    { seed: "pe", t: "Physical Education", d: "Gross-motor skills, teamwork and confidence.", time: "Fri · 15:30–16:30", price: "₩70,000 / month" },
    { seed: "english-plus", t: "English Plus", d: "Phonics, reading and conversation.", time: "Mon, Wed · 16:30–17:30", price: "₩120,000 / month" },
    { seed: "story", t: "Story & Drama", d: "English stories and role-play.", time: "Tue, Thu · 16:30–17:30", price: "₩90,000 / month" },
    { seed: "soccer", t: "Soccer & Ball Sports", d: "Coordination, fitness and fair play.", time: "Fri · 16:00–17:00", price: "₩75,000 / month" },
  ] },
  { title: "Saturday School", sub: "Weekend English programmes · monthly (4 sessions)", cat: "weekend,children,english", programs: [
    { seed: "sat-english", t: "Saturday English", d: "Play-based English activities every Saturday morning.", time: "Sat · 10:00–12:00", price: "₩160,000 / month" },
    { seed: "weekend-art", t: "Weekend Art & Play", d: "Creative art and play in English on weekends.", time: "Sat · 13:00–15:00", price: "₩140,000 / month" },
  ] },
  { title: "Seasonal Camp", sub: "Holiday English camps · per session", cat: "camp,summer,children", programs: [
    { seed: "summer-camp", t: "Summer English Camp", d: "A month of water play, English cooking and outdoor adventures.", time: "Daily · 09:00–15:00", price: "₩450,000 / 4 weeks" },
    { seed: "winter-camp", t: "Winter English Camp", d: "Three weeks of cozy English stories, crafts and play.", time: "Daily · 09:00–14:00", price: "₩350,000 / 3 weeks" },
  ] },
] : [
  { title: "방과후", sub: "정규 일과 후 평일 특별활동 · 월 단위", cat: "afterschool,children,activity", programs: [
    { seed: "ballet", t: "발레", d: "바른 자세, 균형, 유연성, 리듬감을 기릅니다.", time: "화 · 15:30–16:30", price: "월 90,000원" },
    { seed: "dance", t: "무용 · 공연 예술", d: "상상력과 표현력, 무대 자신감을 키웁니다.", time: "목 · 15:30–16:30", price: "월 90,000원" },
    { seed: "art", t: "아트 스튜디오", d: "다양한 재료로 창의력을 펼칩니다.", time: "월 · 15:30–16:30", price: "월 80,000원" },
    { seed: "music", t: "음악 · 피아노", d: "컬러 음표로 멜로디와 타악기를 배웁니다.", time: "수 · 15:30–16:30", price: "월 100,000원" },
    { seed: "pe", t: "체육", d: "대근육 발달과 협동, 자신감을 기릅니다.", time: "금 · 15:30–16:30", price: "월 70,000원" },
    { seed: "english-plus", t: "영어 플러스", d: "파닉스, 영어 독서, 회화로 영어를 심화합니다.", time: "월, 수 · 16:30–17:30", price: "월 120,000원" },
    { seed: "story", t: "스토리 · 드라마", d: "영어 동화와 역할 놀이로 말하기 자신감을.", time: "화, 목 · 16:30–17:30", price: "월 90,000원" },
    { seed: "soccer", t: "축구 · 볼 스포츠", d: "협응력과 체력, 페어플레이 정신을 기릅니다.", time: "금 · 16:00–17:00", price: "월 75,000원" },
  ] },
  { title: "토요학교", sub: "주말 영어 프로그램 · 월 4회", cat: "weekend,children,english", programs: [
    { seed: "sat-english", t: "토요 영어", d: "매주 토요일 오전 놀이 중심 영어 활동.", time: "토 · 10:00–12:00", price: "월 160,000원" },
    { seed: "weekend-art", t: "주말 아트 · 놀이", d: "주말에 즐기는 영어 미술과 놀이.", time: "토 · 13:00–15:00", price: "월 140,000원" },
  ] },
  { title: "계절 캠프", sub: "방학 영어 캠프 · 세션 단위", cat: "camp,summer,children", programs: [
    { seed: "summer-camp", t: "여름 영어 캠프", d: "물놀이, 영어 요리, 야외 탐험으로 가득한 한 달.", time: "매일 · 09:00–15:00", price: "450,000원 (4주)" },
    { seed: "winter-camp", t: "겨울 영어 캠프", d: "영어 동화와 만들기, 놀이로 보내는 3주.", time: "매일 · 09:00–14:00", price: "350,000원 (3주)" },
  ] },
];

const avail: Record<string, { sat: boolean; camp: boolean }> = {
  "seoul-gangnam": { sat: true, camp: true },
  "busan-haeundae": { sat: true, camp: true },
  "daejeon-yuseong": { sat: true, camp: true },
  "daegu-suseong": { sat: false, camp: false },
  "gwangju-namgu": { sat: true, camp: true },
};
const yes = en ? "Available" : "운영";
const no = en ? "—" : "미운영";
const cols = en
  ? ["Campus", "Age", "Afterschool", "Saturday School", "Seasonal Camp"]
  : ["캠퍼스", "연령", "방과후", "토요학교", "계절 캠프"];
const tag = (ok: boolean) => ok
  ? `<span class="inline-block rounded-full bg-teal-100 px-2.5 py-1 text-xs font-semibold text-teal-700">${yes}</span>`
  : `<span class="inline-block rounded-full bg-black/5 px-2.5 py-1 text-xs font-semibold text-ink/40">${no}</span>`;
---
<section class="bg-navy-900 text-white"><div class="reveal mx-auto max-w-6xl px-6 py-20">
  <p class="text-sm font-semibold uppercase tracking-wide text-gold">{eyebrow}</p>
  <h1 class="mt-2 font-serif text-4xl font-semibold md:text-5xl">{title}</h1>
  <p class="mt-5 max-w-2xl text-white/75">{intro}</p>
</div></section>

{groups.map((g, gi) => (
  <section class={gi % 2 === 0 ? "bg-white" : "bg-cream"}><div class="mx-auto max-w-6xl px-6 py-16">
    <div class="rule-gold mb-6"></div>
    <h2 class="reveal font-serif text-3xl font-semibold text-navy-900">{g.title}</h2>
    <p class="reveal mt-2 text-sm font-semibold uppercase tracking-wide text-gold">{g.sub}</p>
    <div data-reveal-children class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {g.programs.map((pr) => (
        <div class="group flex flex-col overflow-hidden rounded-2xl bg-white ring-1 ring-black/5 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-md">
          <div class="relative aspect-[4/3] overflow-hidden">
            <Figure alt={pr.t} cat={g.cat} seed={pr.seed} class="absolute inset-0 h-full w-full transition duration-700 group-hover:scale-110" rounded="rounded-none" />
          </div>
          <div class="flex flex-1 flex-col p-5">
            <h3 class="font-serif text-lg font-semibold text-navy-900">{pr.t}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-ink/70">{pr.d}</p>
            <div class="mt-auto space-y-1.5 border-t border-black/5 pt-3 text-sm">
              <p class="flex items-center gap-2 text-ink/65">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-gold"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                {pr.time}
              </p>
              <p class="flex items-center gap-2 font-serif font-semibold text-navy">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-gold"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 0 1 5 0c0 2.5-2.5 2-2.5 4"/><path d="M12 17h.01"/></svg>
                {pr.price}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div></section>
))}

<section class="bg-cream"><div class="mx-auto max-w-6xl px-6 py-16">
  <div class="rule-gold mb-6"></div>
  <h2 class="reveal font-serif text-3xl font-semibold text-navy-900">{en ? "Availability by Campus" : "캠퍼스별 운영 안내"}</h2>
  <div class="reveal mt-8 overflow-x-auto rounded-2xl bg-white ring-1 ring-black/5">
    <table class="w-full text-left text-sm">
      <thead><tr class="border-b border-black/10 text-navy-900">
        {cols.map((c) => (<th class="px-5 py-4 font-semibold">{c}</th>))}
      </tr></thead>
      <tbody>
        {branches.map((b: any) => (
          <tr class="border-b border-black/5 last:border-0">
            <td class="px-5 py-4 font-semibold text-navy-900">{b.name}</td>
            <td class="px-5 py-4 text-ink/70">{en ? "Ages 3–6" : "만 3–6세"}</td>
            <td class="px-5 py-4" set:html={tag(true)} />
            <td class="px-5 py-4" set:html={tag(avail[b.slug]?.sat ?? false)} />
            <td class="px-5 py-4" set:html={tag(avail[b.slug]?.camp ?? false)} />
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="mt-4 text-xs text-ink/50">{en ? "Programs, schedules and fees may vary by campus and term. Contact your campus for current details." : "프로그램과 일정, 비용은 캠퍼스와 학기에 따라 달라질 수 있습니다. 자세한 내용은 각 캠퍼스로 문의해 주세요."}</p>
</div></section>

<section class="bg-white"><div class="mx-auto max-w-6xl px-6 py-16 text-center">
  <h2 class="reveal font-serif text-2xl font-semibold text-navy-900 md:text-3xl">{en ? "Questions about enrichment?" : "방과후 프로그램이 궁금하신가요?"}</h2>
  <p class="reveal mx-auto mt-3 max-w-xl text-ink/70">{en ? "Our bilingual team is happy to help with programs, schedules and registration." : "이중언어 상담팀이 프로그램과 일정, 신청을 친절히 안내해 드립니다."}</p>
  <div class="reveal mt-7 flex flex-wrap justify-center gap-3">
    <a href={p("/admissions")} class="rounded-full bg-gold px-6 py-3 text-sm font-semibold text-navy-900 transition hover:brightness-95">{en ? "Apply" : "입학 신청"}</a>
    <a href={p("/contact")} class="rounded-full bg-navy px-6 py-3 text-sm font-semibold text-white transition hover:bg-navy-900">{en ? "Contact us" : "문의하기"}</a>
  </div>
</div></section>
