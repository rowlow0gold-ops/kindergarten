---
import { localizePath, type Locale } from "../../i18n/ui";
import Molecule from "../Molecule.astro";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const p = (path: string) => localizePath(path, locale);
const c = locale === "en" ? {
  title: "Innovator Program", lead: "Six pillars of learning that turn curiosity into capability.",
  intro: "Our proprietary STEM programme weaves science, technology and entrepreneurship into every stage — building the mindset of an innovator.",
  pillars: ["English","Mathematics","Engineering & Technology","Science","Computer Science","Entrepreneurship"],
  techTitle: "Learning with leading technology", tech: ["Robotics","Drones","3D Printers","VR / AR"],
  skillsTitle: "21st-century skills", skills: ["Critical thinking","Creativity","Collaboration","Communication","Problem-solving","Resilience"],
} : {
  title: "이노베이터 프로그램", lead: "호기심을 역량으로 바꾸는 여섯 가지 학습 기둥.",
  intro: "한빛 고유의 STEM 프로그램은 과학·기술·기업가정신을 모든 단계에 녹여, 혁신가의 사고방식을 길러줍니다.",
  pillars: ["영어","수학","공학 · 기술","과학","컴퓨터 과학","기업가정신"],
  techTitle: "첨단 기술로 배우기", tech: ["로보틱스","드론","3D 프린터","VR / AR"],
  skillsTitle: "21세기 핵심 역량", skills: ["비판적 사고","창의력","협업","의사소통","문제 해결","회복탄력성"],
};
---
<section class="relative overflow-hidden bg-navy-900 text-white">
  <div class="absolute inset-0 opacity-[0.15]" style="background-image: radial-gradient(circle,#fff 1px,transparent 1px); background-size: 24px 24px;"></div>
  <Molecule class="absolute -right-6 top-12 w-40 h-40 float-slow opacity-40" />
  <div class="relative mx-auto max-w-6xl px-5 py-24 text-center">
    <h1 class="reveal font-serif text-4xl font-semibold md:text-6xl">{c.title}</h1>
    <p class="reveal mx-auto mt-5 max-w-xl text-white/75">{c.lead}</p>
  </div>
</section>
<section class="bg-white"><div class="reveal mx-auto max-w-4xl px-5 py-16 text-center"><p class="font-serif text-xl leading-relaxed text-navy-900 md:text-2xl">{c.intro}</p></div></section>
<section class="bg-cream"><div class="mx-auto max-w-6xl px-5 py-16">
  <div data-reveal-children class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {c.pillars.map((x,i)=>(<div class="rounded-2xl bg-white p-7 shadow-sm"><span class="font-serif text-2xl font-semibold text-gold">{String(i+1).padStart(2,"0")}</span><h3 class="mt-2 font-serif text-lg font-semibold text-navy-900">{x}</h3></div>))}
  </div>
</div></section>
<section class="bg-navy-900 text-white"><div class="mx-auto max-w-6xl px-5 py-16">
  <h2 class="reveal font-serif text-2xl font-semibold md:text-3xl">{c.techTitle}</h2>
  <div data-reveal-children class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-4">
    {c.tech.map((x)=>(<div class="rounded-2xl bg-white/5 p-6 text-center ring-1 ring-white/10"><p class="font-serif text-lg text-gold-soft">{x}</p></div>))}
  </div>
</div></section>
<section class="bg-white"><div class="mx-auto max-w-6xl px-5 py-16">
  <h2 class="reveal font-serif text-2xl font-semibold text-navy-900 md:text-3xl">{c.skillsTitle}</h2>
  <div data-reveal-children class="mt-8 flex flex-wrap gap-3">
    {c.skills.map((x)=>(<span class="rounded-full bg-cream px-5 py-2 text-sm font-medium text-navy">{x}</span>))}
  </div>
</div></section>
