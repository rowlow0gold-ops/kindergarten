---
import { localizePath, type Locale } from "../../i18n/ui";
import siteKo from "../../data/site.json";
import siteEn from "../../data/en/site.json";
import branchesKo from "../../data/branches.json";
import branchesEn from "../../data/en/branches.json";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const en = locale === "en";
const p = (path: string) => localizePath(path, locale);
const site = en ? siteEn : siteKo;
const branches = en ? branchesEn : branchesKo;
const c = en
  ? { title: "Contact Us", sub: "The fastest way to reach us is our KakaoTalk channel.", kTitle: "Chat with us on KakaoTalk", kSub: "Ask us anything — admissions, campuses or programs. We reply quickly during weekday hours.", kBtn: "Open KakaoTalk channel", kNote: "Free to use · no app sign-up needed", phoneTitle: "Prefer to call or email?", dirTitle: "Campus Phone Directory" }
  : { title: "문의하기", sub: "가장 빠른 상담은 카카오톡 채널로 도와드립니다.", kTitle: "카카오톡으로 문의하기", kSub: "입학·캠퍼스·프로그램 무엇이든 편하게 물어보세요. 평일 상담 시간 내 빠르게 답변드립니다.", kBtn: "카카오톡 채널 열기", kNote: "별도 가입 없이 무료로 이용하실 수 있어요", phoneTitle: "전화·이메일 문의", dirTitle: "캠퍼스 전화 안내" };
---
<section class="bg-navy-900 text-white">
  <div class="reveal mx-auto max-w-6xl px-5 py-20 text-center">
    <h1 class="font-serif text-4xl font-semibold md:text-5xl">{c.title}</h1>
    <p class="mt-4 text-white/70">{c.sub}</p>
  </div>
</section>

<section class="bg-white">
  <div class="mx-auto grid max-w-6xl items-start gap-12 px-5 py-16 md:grid-cols-2">
    <div class="reveal rounded-3xl bg-[#FEE500] p-8 text-[#181600] md:p-10">
      <span class="grid h-14 w-14 place-items-center rounded-2xl bg-[#181600]/10">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="#181600" aria-hidden="true"><path d="M12 3C6.48 3 2 6.58 2 11c0 2.7 1.7 5.07 4.27 6.52L5 22l4.9-2.6c.69.08 1.39.13 2.1.13 5.52 0 10-3.58 10-8s-4.48-8.53-10-8.53Z"/></svg>
      </span>
      <h2 class="mt-6 font-serif text-2xl font-semibold md:text-3xl">{c.kTitle}</h2>
      <p class="mt-3 leading-relaxed text-[#181600]/80">{c.kSub}</p>
      <a href={site.kakaoUrl} target="_blank" rel="noopener noreferrer" class="mt-7 inline-flex items-center gap-2 rounded-full bg-[#181600] px-7 py-3.5 text-sm font-semibold text-[#FEE500] transition hover:brightness-110">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3C6.48 3 2 6.58 2 11c0 2.7 1.7 5.07 4.27 6.52L5 22l4.9-2.6c.69.08 1.39.13 2.1.13 5.52 0 10-3.58 10-8s-4.48-8.53-10-8.53Z"/></svg>
        {c.kBtn}
      </a>
      <p class="mt-4 text-xs font-medium text-[#181600]/55">{c.kNote}</p>
    </div>

    <div class="reveal">
      <h2 class="font-serif text-xl font-semibold text-navy-900">{c.phoneTitle}</h2>
      <p class="mt-3 text-sm"><a href={`mailto:${site.email}`} class="text-navy hover:text-gold">{site.email}</a></p>
      <p class="mt-1 text-sm"><a href={`tel:${site.phone}`} class="text-navy hover:text-gold">{site.phone}</a></p>
      <h3 class="mt-8 text-xs font-semibold uppercase tracking-[0.12em] text-ink/45">{c.dirTitle}</h3>
      <ul class="mt-3 divide-y divide-black/5 border-y border-black/5">
        {branches.map((b) => (
          <li class="flex items-center justify-between py-3">
            <span class="text-sm text-ink/80">{b.name}</span>
            <a href={`tel:${b.phone}`} class="text-sm font-medium text-navy hover:text-gold">{b.phone}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
