---
import { type Locale } from "../../i18n/ui";
import siteKo from "../../data/site.json";
import siteEn from "../../data/en/site.json";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const en = locale === "en";
const site = en ? siteEn : siteKo;
const c = en
  ? { title: "Contact Us", sub: "Reach us on the channel that suits you best.",
      kTitle: "Chat on KakaoTalk", kSub: "Ask us anything — admissions, campuses or programs. We reply quickly during weekday hours.", kBtn: "Open KakaoTalk channel", kNote: "Open daily 9:00 ~ 18:00",
      wTitle: "Chat on WhatsApp", wSub: "International families can reach us here. Message us anytime and we'll get back to you.", wBtn: "Open WhatsApp", wNote: "Open daily 9:00 ~ 18:00",
      aTitle: "AI Chatbot", aSub: "Get instant answers about admissions, campuses and programs — powered by AI.", aBtn: "Start AI chat", aNote: "Available 24 hours",
      fTitle: "Hanbit Bot", fSub: "Tap a topic and get an instant answer — admissions, tuition, meals, shuttle and more.", fBtn: "Open the bot", fNote: "Available 24 hours" }
  : { title: "문의하기", sub: "편하신 채널로 문의해 주세요.",
      kTitle: "카카오톡으로 문의하기", kSub: "입학·캠퍼스·프로그램 무엇이든 편하게 물어보세요. 평일 상담 시간 내 빠르게 답변드립니다.", kBtn: "카카오톡 채널 열기", kNote: "운영 시간 9:00 ~ 18:00",
      wTitle: "왓츠앱으로 문의하기", wSub: "해외에 계신 가정도 편하게 문의해 주세요. 메시지를 남겨주시면 빠르게 답변드립니다.", wBtn: "왓츠앱 열기", wNote: "운영 시간 9:00 ~ 18:00",
      aTitle: "AI 챗봇", aSub: "입학·캠퍼스·프로그램에 대한 궁금증을 AI가 즉시 답해드립니다.", aBtn: "AI 챗봇 시작", aNote: "24시간 이용 가능",
      fTitle: "한빛 봇", fSub: "주제를 누르면 입학·수업료·급식·셔틀 등 궁금한 내용을 바로 확인할 수 있어요.", fBtn: "봇 열기", fNote: "24시간 이용 가능" };
---
<section class="bg-navy-900 text-white">
  <div class="reveal mx-auto max-w-6xl px-5 py-20 text-center">
    <h1 class="font-serif text-4xl font-semibold md:text-5xl">{c.title}</h1>
    <p class="mt-4 text-white/70">{c.sub}</p>
  </div>
</section>

<section class="bg-white">
  <div class="mx-auto grid max-w-5xl items-stretch gap-8 px-5 py-16 md:grid-cols-2">
    <div class="reveal flex flex-col rounded-3xl bg-[#FEE500] p-8 text-[#181600] md:p-10">
      <span class="grid h-14 w-14 place-items-center rounded-2xl bg-[#181600]/10">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="#181600" aria-hidden="true"><path d="M12 3C6.48 3 2 6.58 2 11c0 2.7 1.7 5.07 4.27 6.52L5 22l4.9-2.6c.69.08 1.39.13 2.1.13 5.52 0 10-3.58 10-8s-4.48-8.53-10-8.53Z"/></svg>
      </span>
      <h2 class="mt-6 font-serif text-2xl font-semibold md:text-3xl">{c.kTitle}</h2>
      <p class="mt-3 leading-relaxed text-[#181600]/80">{c.kSub}</p>
      <a href={site.kakaoUrl} target="_blank" rel="noopener noreferrer" class="mt-7 inline-flex items-center gap-2 self-start rounded-full bg-[#181600] px-7 py-3.5 text-sm font-semibold text-[#FEE500] transition hover:brightness-110">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3C6.48 3 2 6.58 2 11c0 2.7 1.7 5.07 4.27 6.52L5 22l4.9-2.6c.69.08 1.39.13 2.1.13 5.52 0 10-3.58 10-8s-4.48-8.53-10-8.53Z"/></svg>
        {c.kBtn}
      </a>
      <p class="mt-4 text-xs font-medium text-[#181600]/55">{c.kNote}</p>
    </div>

    <div class="reveal flex flex-col rounded-3xl bg-[#25D366] p-8 text-white md:p-10">
      <span class="grid h-14 w-14 place-items-center rounded-2xl bg-white/20">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.9c0 2.1.55 4.06 1.6 5.83L2 22l4.4-1.15a9.86 9.86 0 0 0 5.64 1.74c5.46 0 9.9-4.45 9.9-9.9 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 1.8c2.16 0 4.18.84 5.71 2.37a8.03 8.03 0 0 1 2.37 5.72c0 4.46-3.63 8.08-8.09 8.08a8.1 8.1 0 0 1-4.12-1.13l-.3-.18-2.61.68.7-2.55-.19-.31a8.02 8.02 0 0 1-1.24-4.27c0-4.46 3.63-8.09 8.08-8.09Zm-2.86 4.3c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2 0 1.18.86 2.32.98 2.48.12.16 1.69 2.58 4.1 3.62.57.25 1.02.4 1.37.5.57.18 1.1.16 1.51.1.46-.07 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.01-.37-1.93-1.19-.71-.64-1.19-1.42-1.33-1.66-.14-.24-.01-.37.11-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.2-.47-.4-.4-.54-.41h-.46Z"/></svg>
      </span>
      <h2 class="mt-6 font-serif text-2xl font-semibold md:text-3xl">{c.wTitle}</h2>
      <p class="mt-3 leading-relaxed text-white/90">{c.wSub}</p>
      <a href={site.whatsappUrl} target="_blank" rel="noopener noreferrer" class="mt-7 inline-flex items-center gap-2 self-start rounded-full bg-white px-7 py-3.5 text-sm font-semibold text-[#1a7a44] transition hover:brightness-95">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.9c0 2.1.55 4.06 1.6 5.83L2 22l4.4-1.15a9.86 9.86 0 0 0 5.64 1.74c5.46 0 9.9-4.45 9.9-9.9 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm-2.86 6.1c.16 0 .32 0 .46.01.14.01.34-.06.54.41.2.48.68 1.66.74 1.78.06.12.1.26.02.42-.08.16-.12.26-.24.4-.12.14-.25.31-.36.42-.12.12-.25.25-.11.49.14.24.62 1.02 1.33 1.66.92.82 1.69 1.07 1.93 1.19.24.12.38.1.52-.06.14-.16.6-.7.76-.94.16-.24.32-.2.54-.12.22.08 1.4.66 1.64.78.24.12.4.18.46.28.06.1.06.58-.14 1.14-.2.56-1.16 1.07-1.62 1.14-.41.06-.94.08-1.51-.1-.35-.1-.8-.25-1.37-.5-2.41-1.04-3.98-3.46-4.1-3.62-.12-.16-.98-1.3-.98-2.48 0-1.18.62-1.76.84-2 .22-.24.48-.3.64-.3Z"/></svg>
        {c.wBtn}
      </a>
      <p class="mt-4 text-xs font-medium text-white/70">{c.wNote}</p>
    </div>

    <div class="reveal flex flex-col rounded-3xl bg-navy-900 p-8 text-white md:p-10">
      <span class="grid h-14 w-14 place-items-center rounded-2xl bg-white/15 text-gold">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="8" width="16" height="10" rx="2.5"/><path d="M12 4.8V8"/><circle cx="12" cy="3.6" r="1.3"/><circle cx="9.2" cy="13" r="1.25" fill="currentColor" stroke="none"/><circle cx="14.8" cy="13" r="1.25" fill="currentColor" stroke="none"/><path d="M2.6 12v2.6M21.4 12v2.6"/></svg>
      </span>
      <h2 class="mt-6 font-serif text-2xl font-semibold md:text-3xl">{c.aTitle}</h2>
      <p class="mt-3 leading-relaxed text-white/80">{c.aSub}</p>
      <button type="button" data-open-ai class="mt-7 inline-flex items-center gap-2 self-start rounded-full bg-gold px-7 py-3.5 text-sm font-semibold text-navy-900 transition hover:brightness-95">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.6 4.4L18 9l-4.4 1.6L12 15l-1.6-4.4L6 9l4.4-1.6L12 3Z"/></svg>
        {c.aBtn}
      </button>
      <p class="mt-4 text-xs font-medium text-white/55">{c.aNote}</p>
    </div>

    <div class="reveal flex flex-col rounded-3xl bg-cream p-8 text-navy-900 ring-1 ring-navy-900/10 md:p-10">
      <span class="grid h-14 w-14 place-items-center rounded-2xl bg-navy-900/10 text-navy-900">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z"/></svg>
      </span>
      <h2 class="mt-6 font-serif text-2xl font-semibold md:text-3xl">{c.fTitle}</h2>
      <p class="mt-3 leading-relaxed text-navy-900/70">{c.fSub}</p>
      <button type="button" data-open-free class="mt-7 inline-flex items-center gap-2 self-start rounded-full bg-navy-900 px-7 py-3.5 text-sm font-semibold text-white transition hover:bg-navy-700">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z"/></svg>
        {c.fBtn}
      </button>
      <p class="mt-4 text-xs font-medium text-navy-900/50">{c.fNote}</p>
    </div>
  </div>
</section>
