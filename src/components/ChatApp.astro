---
import bot from "../data/botFree.json";
import { type Locale } from "../i18n/ui";
interface Props { mode: "ai" | "free"; locale: Locale; }
const { mode, locale } = Astro.props;
const en = locale === "en";
const free = (bot as any)[locale] || (bot as any).ko;
const isFree = mode === "free";
const title = mode === "ai" ? (en ? "AI Chatbot" : "AI 챗봇") : (en ? "Hanbit Bot" : "한빛 봇");
const status = isFree
  ? (en ? "Online · replies instantly" : "온라인 · 바로 답해드려요")
  : (en ? "AI assistant" : "AI 도우미");
const ui = {
  placeholder: en ? "Type a message…" : "메시지를 입력하세요…",
  send: en ? "Send" : "보내기",
  suggested: en ? "Tap a topic" : "주제를 선택하세요",
  demo: en ? "Demo mode — the AI model isn't connected yet. For quick answers, try the Chatbot." : "데모 모드 — AI 모델이 아직 연결되지 않았어요. 빠른 답변은 '챗봇'을 이용해 주세요.",
  aiGreeting: en ? "Hi! I'm the Hanbit AI assistant. Ask me anything about the school." : "안녕하세요! 한빛 AI 도우미예요. 학교에 대해 무엇이든 물어보세요.",
  error: en ? "Sorry, I couldn't reach the assistant. Please try again." : "죄송해요, 응답을 가져오지 못했어요. 다시 시도해 주세요.",
};
---
<div
  data-chat={mode}
  class="fixed inset-0 z-[2100] hidden items-center justify-center p-4"
>
  <div data-chat-close class="absolute inset-0 bg-navy-900/50 backdrop-blur-sm"></div>
  <div
    class="relative flex w-full max-w-md flex-col overflow-hidden rounded-3xl bg-white shadow-2xl ring-1 ring-black/10"
    style="height: min(34rem, calc(100vh - 5rem));"
  >
    <header class="flex items-center gap-3 bg-navy-900 px-4 py-3.5 text-white">
      <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-white/15 text-gold">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="8" width="16" height="10" rx="2.5"/><path d="M12 4.8V8"/><circle cx="12" cy="3.6" r="1.3"/><circle cx="9.2" cy="13" r="1.25" fill="currentColor" stroke="none"/><circle cx="14.8" cy="13" r="1.25" fill="currentColor" stroke="none"/><path d="M2.6 12v2.6M21.4 12v2.6"/></svg>
      </span>
      <span class="flex flex-col leading-tight">
        <span class="font-serif text-sm font-semibold">{title}</span>
        <span class="mt-0.5 flex items-center gap-1.5 text-[0.7rem] text-white/65">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-400"></span>{status}
        </span>
      </span>
      <button data-chat-close aria-label="Close" class="ml-auto text-white/70 transition hover:text-white"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
    </header>
    <div data-chat-log class="flex-1 space-y-2.5 overflow-y-auto bg-cream/30 px-3 py-3 pb-4"></div>
    {!isFree && (
      <form data-chat-form class="flex items-center gap-2 border-t border-black/10 bg-white p-2.5">
        <input data-chat-input type="text" autocomplete="off" placeholder={ui.placeholder} class="min-w-0 flex-1 rounded-full border border-black/15 px-3.5 py-2 text-sm outline-none focus:border-gold" />
        <button type="submit" aria-label={ui.send} class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-navy-900 text-white transition hover:bg-navy-700"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg></button>
      </form>
    )}
  </div>
</div>
<script define:vars={{ mode, free, ui }}>
  (function () {
    var root = document.querySelector('[data-chat="' + mode + '"]');
    if (!root) return;
    var log = root.querySelector("[data-chat-log]");
    var form = root.querySelector("[data-chat-form]");
    var input = root.querySelector("[data-chat-input]");
    var started = false;
    var history = [];
    var BOT_AVATAR = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="8" width="16" height="10" rx="2.5"/><path d="M12 4.8V8"/><circle cx="12" cy="3.6" r="1.3"/><circle cx="9.2" cy="13" r="1.25" fill="currentColor" stroke="none"/><circle cx="14.8" cy="13" r="1.25" fill="currentColor" stroke="none"/><path d="M2.6 12v2.6M21.4 12v2.6"/></svg>';
    function bubble(text, who) {
      if (who === "user") {
        var u = document.createElement("div");
        u.className = "ml-auto max-w-[85%] rounded-2xl rounded-br-sm bg-navy-900 px-3 py-2 text-sm leading-relaxed text-white";
        u.textContent = text;
        log.appendChild(u); log.scrollTop = log.scrollHeight;
        return u;
      }
      var row = document.createElement("div");
      row.className = "flex items-end gap-2";
      var av = document.createElement("span");
      av.className = "grid h-7 w-7 shrink-0 place-items-center rounded-full bg-navy-900 text-gold";
      av.innerHTML = BOT_AVATAR;
      var d = document.createElement("div");
      d.className = "max-w-[80%] rounded-2xl rounded-bl-sm bg-white px-3 py-2 text-sm leading-relaxed text-ink/85 ring-1 ring-black/5";
      d.textContent = text;
      row.appendChild(av); row.appendChild(d);
      log.appendChild(row); log.scrollTop = log.scrollHeight;
      return row;
    }
    function typingBubble() {
      var row = document.createElement("div");
      row.className = "flex items-end gap-2";
      row.innerHTML = '<span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-navy-900 text-gold">' + BOT_AVATAR + '</span>'
        + '<div class="rounded-2xl rounded-bl-sm bg-white px-3 py-2.5 ring-1 ring-black/5"><span class="chat-typing"><i></i><i></i><i></i></span></div>';
      log.appendChild(row); log.scrollTop = log.scrollHeight;
      return row;
    }
    function freeAnswer(q) {
      var t = q.toLowerCase();
      for (var i = 0; i < free.intents.length; i++) {
        var it = free.intents[i];
        for (var k = 0; k < it.keywords.length; k++) {
          if (t.indexOf(String(it.keywords[k]).toLowerCase()) >= 0) return it.answer;
        }
      }
      return free.fallback;
    }
    var pool = (free.quickReplies || []).slice();
    var ptr = 0;
    var currentSuggest = null;
    function nextThree(exclude) {
      var picks = [], guard = 0;
      while (picks.length < 3 && guard < pool.length * 3 && pool.length) {
        var t = pool[ptr % pool.length]; ptr++; guard++;
        if (t !== exclude && picks.indexOf(t) < 0) picks.push(t);
      }
      return picks;
    }
    function suggest(exclude) {
      if (currentSuggest) { currentSuggest.remove(); currentSuggest = null; }
      var items = nextThree(exclude);
      if (!items.length) return;
      var wrap = document.createElement("div");
      wrap.className = "flex flex-col items-start gap-1.5 pl-9 pt-1";
      var lbl = document.createElement("p");
      lbl.className = "text-[0.65rem] font-semibold uppercase tracking-wide text-ink/35";
      lbl.textContent = ui.suggested;
      wrap.appendChild(lbl);
      items.forEach(function (q) {
        var b = document.createElement("button");
        b.type = "button"; b.textContent = q;
        b.className = "rounded-full border border-navy/20 bg-white px-3 py-1.5 text-xs font-medium text-navy shadow-sm transition hover:border-gold hover:bg-cream";
        b.onclick = function () { if (currentSuggest === wrap) currentSuggest = null; wrap.remove(); send(q); };
        wrap.appendChild(b);
      });
      log.appendChild(wrap); log.scrollTop = log.scrollHeight;
      currentSuggest = wrap;
    }
    function aiSend(q) {
      history.push({ role: "user", content: q });
      var typing = typingBubble();
      fetch("/api/chat", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ messages: history }) })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          typing.remove();
          if (d && d.unconfigured) { bubble(ui.demo, "bot"); return; }
          if (d && d.reply) { history.push({ role: "assistant", content: d.reply }); bubble(d.reply, "bot"); return; }
          bubble(ui.error, "bot");
        })
        .catch(function () { typing.remove(); bubble(ui.error, "bot"); });
    }
    function send(q) {
      q = (q || "").trim(); if (!q) return;
      if (currentSuggest) { currentSuggest.remove(); currentSuggest = null; }
      bubble(q, "user");
      if (mode === "free") {
        var typing = typingBubble();
        setTimeout(function () { typing.remove(); bubble(freeAnswer(q), "bot"); suggest(q); }, 520);
      } else { aiSend(q); }
    }
    function start() {
      if (started) return; started = true;
      if (mode === "free") { bubble(free.greeting, "bot"); suggest(null); }
      else { bubble(ui.aiGreeting, "bot"); }
    }
    if (form) form.addEventListener("submit", function (e) { e.preventDefault(); var v = input.value; input.value = ""; send(v); });
    root._chatStart = start;
  })();
</script>
<style>
  .chat-typing { display: inline-flex; align-items: center; gap: 4px; }
  .chat-typing i { width: 6px; height: 6px; border-radius: 9999px; background: var(--color-navy); opacity: .35; animation: chatDot 1s infinite ease-in-out; }
  .chat-typing i:nth-child(2) { animation-delay: .15s; }
  .chat-typing i:nth-child(3) { animation-delay: .3s; }
  @keyframes chatDot { 0%, 60%, 100% { opacity: .25; transform: translateY(0); } 30% { opacity: .9; transform: translateY(-3px); } }
</style>
