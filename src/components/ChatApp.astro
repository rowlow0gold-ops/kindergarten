---
import bot from "../data/botFree.json";
import { type Locale } from "../i18n/ui";
interface Props { mode: "ai" | "free"; locale: Locale; }
const { mode, locale } = Astro.props;
const en = locale === "en";
const free = (bot as any)[locale] || (bot as any).ko;
const isFree = mode === "free";
const title = mode === "ai" ? (en ? "AI Chatbot" : "AI 챗봇") : (en ? "Hanbit Bot" : "한빛 봇");
// Free bot is a local guide (no server) — it shows a plain descriptor, never an "online" status.
// AI bot status is set live from the server connection (see script).
const freeStatus = en ? "Instant answers" : "바로 답해드려요";
const ui = {
  placeholder: en ? "Type a message…" : "메시지를 입력하세요…",
  send: en ? "Send" : "보내기",
  suggested: en ? "Tap a topic" : "주제를 선택하세요",
  demo: en ? "Demo mode — the AI model isn't connected yet. For quick answers, try the Bot." : "데모 모드 — AI 모델이 아직 연결되지 않았어요. 빠른 답변은 '봇'을 이용해 주세요.",
  aiGreeting: en ? "Hi! I'm the Hanbit AI assistant. Ask me anything about the school." : "안녕하세요! 한빛 AI 도우미예요. 학교에 대해 무엇이든 물어보세요.",
  error: en ? "Sorry, I couldn't reach the assistant. Please try again." : "죄송해요, 응답을 가져오지 못했어요. 다시 시도해 주세요.",
  stChecking: en ? "Checking connection…" : "연결 확인 중…",
  stOnline: en ? "Online" : "온라인",
  stOffline: en ? "Offline · can't reach the server" : "오프라인 · 서버에 연결할 수 없어요",
  stDemo: en ? "Demo mode · not connected" : "데모 모드 · 연결되지 않음",
  gateTitle: en ? "Quick security check" : "보안 확인 중",
  gateSub: en ? "Cloudflare is verifying your browser before connecting you to the AI assistant." : "AI 도우미에 연결하기 전, Cloudflare가 브라우저를 확인하고 있어요.",
  gateFailTitle: en ? "Verification failed" : "확인에 실패했어요",
  gateFailSub: en ? "We couldn't verify your browser, so the AI assistant stays locked. Please try again." : "브라우저 확인에 실패해 AI 도우미를 열 수 없어요. 다시 시도해 주세요.",
  retry: en ? "Try again" : "다시 시도",
};
---
<div
  data-chat={mode}
  class="fixed inset-0 z-[2100] hidden items-center justify-center p-4"
>
  <div data-chat-close class="absolute inset-0 bg-navy-900/50 backdrop-blur-sm"></div>
  <div
    class="relative flex w-full max-w-md flex-col overflow-hidden rounded-3xl bg-white shadow-2xl ring-1 ring-black/10"
    style="height: min(34rem, calc(100vh - 5rem));"
  >
    <header class="flex items-center gap-3 bg-navy-900 px-4 py-3.5 text-white">
      <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-white/15 text-gold">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="8" width="16" height="10" rx="2.5"/><path d="M12 4.8V8"/><circle cx="12" cy="3.6" r="1.3"/><circle cx="9.2" cy="13" r="1.25" fill="currentColor" stroke="none"/><circle cx="14.8" cy="13" r="1.25" fill="currentColor" stroke="none"/><path d="M2.6 12v2.6M21.4 12v2.6"/></svg>
      </span>
      <span class="flex flex-col leading-tight">
        <span class="font-serif text-sm font-semibold">{title}</span>
        <span class="mt-0.5 flex items-center gap-1.5 text-[0.7rem] text-white/65">
          <span data-chat-dot class={"inline-block h-1.5 w-1.5 rounded-full " + (isFree ? "bg-white/40" : "bg-amber-400")}></span>
          <span data-chat-status>{isFree ? freeStatus : ui.stChecking}</span>
        </span>
      </span>
      <button data-chat-close aria-label="Close" class="ml-auto text-white/70 transition hover:text-white"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
    </header>
    <div data-chat-log class={"flex-1 space-y-2.5 overflow-y-auto bg-cream/30 px-3 py-3" + (isFree ? "" : " hidden")}></div>
    {isFree ? (
      <div class="border-t border-black/10 bg-white px-3 py-3">
        <p class="mb-2 px-0.5 text-[0.65rem] font-semibold uppercase tracking-wide text-ink/40">{ui.suggested}</p>
        <div class="flex gap-1.5 overflow-x-auto pb-1 [scrollbar-width:thin]">
          {free.quickReplies.map((q: string) => (
            <button type="button" data-quick={q} class="shrink-0 whitespace-nowrap rounded-full border border-navy/15 bg-cream/60 px-3 py-1.5 text-xs font-medium text-navy transition hover:border-gold hover:bg-cream">{q}</button>
          ))}
        </div>
      </div>
    ) : (
      <Fragment>
      <div data-cf-gate class="flex flex-1 flex-col items-center justify-center gap-4 bg-cream/30 px-6 text-center">
        <div data-cf-gate-msg class="flex flex-col items-center gap-3">
          <span class="grid h-12 w-12 place-items-center rounded-full bg-navy-900/5 text-navy-900">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3Z"/><path d="M9 12l2 2 4-4"/></svg>
          </span>
          <p class="font-serif text-base font-semibold text-navy-900">{ui.gateTitle}</p>
          <p class="max-w-[16rem] text-xs leading-relaxed text-ink/55">{ui.gateSub}</p>
        </div>
        <div data-cf-error class="hidden flex-col items-center gap-3">
          <span class="grid h-12 w-12 place-items-center rounded-full bg-rose-50 text-rose-500">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3Z"/><path d="M12 9v3.5M12 16h.01"/></svg>
          </span>
          <p class="font-serif text-base font-semibold text-navy-900">{ui.gateFailTitle}</p>
          <p class="max-w-[16rem] text-xs leading-relaxed text-ink/55">{ui.gateFailSub}</p>
          <button type="button" data-cf-retry class="mt-1 rounded-full bg-navy-900 px-5 py-2 text-xs font-semibold text-white transition hover:bg-navy-700">{ui.retry}</button>
        </div>
        <div data-cf-turnstile class="min-h-[70px]"></div>
      </div>
      <div data-chat-pane class="hidden">
        <form data-chat-form class="flex items-center gap-2 border-t border-black/10 bg-white p-2.5">
          <input data-chat-input type="text" autocomplete="off" placeholder={ui.placeholder} class="min-w-0 flex-1 rounded-full border border-black/15 px-3.5 py-2 text-sm outline-none focus:border-gold" />
          <button type="submit" aria-label={ui.send} class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-navy-900 text-white transition hover:bg-navy-700"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg></button>
        </form>
      </div>
      </Fragment>
    )}
  </div>
</div>
<script define:vars={{ mode, free, ui }}>
  (function () {
    var root = document.querySelector('[data-chat="' + mode + '"]');
    if (!root) return;
    var API = "https://bot.minhojan-world.site";
    var CF_SITEKEY = "0x4AAAAAADkQXlMunatmsDXf";
    var cfToken = "";
    var cfWidgetId = null;
    function mountTurnstile() {
      if (mode !== "ai") return;
      var el = root.querySelector("[data-cf-turnstile]");
      if (!el || cfWidgetId !== null) return;
      if (!window.turnstile) {
        if (!document.getElementById("cf-turnstile-api")) { // load api.js only when the AI bot is opened
          var s = document.createElement("script");
          s.id = "cf-turnstile-api"; s.src = "https://challenges.cloudflare.com/turnstile/v0/api.js"; s.async = true; s.defer = true;
          document.head.appendChild(s);
        }
        setTimeout(mountTurnstile, 300); return;
      }
      cfWidgetId = window.turnstile.render(el, {
        sitekey: CF_SITEKEY,
        size: "flexible",
        callback: function (t) { cfToken = t; revealChat(); },
        "error-callback": function () { cfToken = ""; if (!revealed) showGateError(); },
        "expired-callback": function () { cfToken = ""; },
      });
    }
    var log = root.querySelector("[data-chat-log]");
    var form = root.querySelector("[data-chat-form]");
    var input = root.querySelector("[data-chat-input]");
    var pane = root.querySelector("[data-chat-pane]");
    var gate = root.querySelector("[data-cf-gate]");
    var gateMsg = root.querySelector("[data-cf-gate-msg]");
    var gateErr = root.querySelector("[data-cf-error]");
    var gateTimer = null;
    var revealed = false;
    function armGateTimer() { clearTimeout(gateTimer); gateTimer = setTimeout(function () { if (!revealed) showGateError(); }, 15000); }
    function showGateError() {
      if (revealed) return;
      clearTimeout(gateTimer);
      if (gateMsg) gateMsg.classList.add("hidden");
      if (gateErr) { gateErr.classList.remove("hidden"); gateErr.classList.add("flex"); }
    }
    function retryGate() {
      if (gateErr) { gateErr.classList.add("hidden"); gateErr.classList.remove("flex"); }
      if (gateMsg) gateMsg.classList.remove("hidden");
      if (cfWidgetId !== null && window.turnstile) window.turnstile.reset(cfWidgetId);
      else { cfWidgetId = null; mountTurnstile(); }
      armGateTimer();
    }
    function revealChat() {
      if (revealed) return; revealed = true;
      clearTimeout(gateTimer);
      if (gateMsg) gateMsg.classList.add("hidden");
      if (gateErr) gateErr.classList.add("hidden");
      if (gate) gate.className = "h-0 overflow-hidden"; // keep Turnstile mounted but out of view
      if (log) log.classList.remove("hidden");
      if (pane) pane.classList.remove("hidden");
      bubble(ui.aiGreeting, "bot");
      probe();
      if (input) setTimeout(function () { input.focus(); }, 30);
    }
    var sendBtn = form ? form.querySelector('button[type="submit"]') : null;
    var busy = false;
    function setBusy(b) {
      busy = b;
      if (input) { input.disabled = b; }
      if (sendBtn) { sendBtn.disabled = b; sendBtn.classList.toggle("opacity-50", b); sendBtn.classList.toggle("cursor-not-allowed", b); }
    }
    var started = false;
    var history = [];
    var dot = root.querySelector("[data-chat-dot]");
    var statusEl = root.querySelector("[data-chat-status]");
    function setStatus(state) {
      if (!dot || !statusEl) return;
      var color = state === "online" ? "bg-emerald-400"
        : state === "offline" ? "bg-rose-400"
        : state === "demo" ? "bg-white/40"
        : "bg-amber-400";
      dot.className = "inline-block h-1.5 w-1.5 rounded-full " + color;
      statusEl.textContent = state === "online" ? ui.stOnline
        : state === "offline" ? ui.stOffline
        : state === "demo" ? ui.stDemo
        : ui.stChecking;
    }
    function probe() {
      setStatus("checking");
      fetch(API + "/healthz", { method: "GET" })
        .then(function (r) { if (!r.ok) throw 0; return r.json(); })
        .then(function (d) {
          if (d && d.status === "ok") setStatus("online");
          else setStatus("offline");
        })
        .catch(function () { setStatus("offline"); });
    }
    var BOT_AVATAR = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="8" width="16" height="10" rx="2.5"/><path d="M12 4.8V8"/><circle cx="12" cy="3.6" r="1.3"/><circle cx="9.2" cy="13" r="1.25" fill="currentColor" stroke="none"/><circle cx="14.8" cy="13" r="1.25" fill="currentColor" stroke="none"/><path d="M2.6 12v2.6M21.4 12v2.6"/></svg>';
    function bubble(text, who) {
      if (who === "user") {
        var u = document.createElement("div");
        u.className = "ml-auto max-w-[85%] rounded-2xl rounded-br-sm bg-navy-900 px-3 py-2 text-sm leading-relaxed text-white";
        u.textContent = text;
        log.appendChild(u); log.scrollTop = log.scrollHeight;
        return u;
      }
      var row = document.createElement("div");
      row.className = "flex items-end gap-2";
      var av = document.createElement("span");
      av.className = "grid h-7 w-7 shrink-0 place-items-center rounded-full bg-navy-900 text-gold";
      av.innerHTML = BOT_AVATAR;
      var d = document.createElement("div");
      d.className = "max-w-[80%] rounded-2xl rounded-bl-sm bg-white px-3 py-2 text-sm leading-relaxed text-ink/85 ring-1 ring-black/5";
      d.textContent = text;
      row.appendChild(av); row.appendChild(d);
      log.appendChild(row); log.scrollTop = log.scrollHeight;
      return row;
    }
    function typingBubble() {
      var row = document.createElement("div");
      row.className = "flex items-end gap-2";
      row.innerHTML = '<span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-navy-900 text-gold">' + BOT_AVATAR + '</span>'
        + '<div class="rounded-2xl rounded-bl-sm bg-white px-3 py-2.5 ring-1 ring-black/5"><span class="chat-typing"><i></i><i></i><i></i></span></div>';
      log.appendChild(row); log.scrollTop = log.scrollHeight;
      return row;
    }
    function quickChips(items) {
      if (!items || !items.length) return;
      var wrap = document.createElement("div");
      wrap.className = "flex flex-wrap gap-2 pl-9";
      items.forEach(function (q) {
        var b = document.createElement("button");
        b.type = "button";
        b.className = "rounded-full border border-navy/15 bg-cream/60 px-3 py-1.5 text-xs font-medium text-navy transition hover:border-gold hover:bg-cream";
        b.textContent = q;
        b.addEventListener("click", function () { send(q); });
        wrap.appendChild(b);
      });
      log.appendChild(wrap); log.scrollTop = log.scrollHeight;
    }
    function freeAnswer(q) {
      var t = q.toLowerCase();
      for (var i = 0; i < free.intents.length; i++) {
        var it = free.intents[i];
        for (var k = 0; k < it.keywords.length; k++) {
          if (t.indexOf(String(it.keywords[k]).toLowerCase()) >= 0) return it.answer;
        }
      }
      return free.fallback;
    }
    function aiSend(q) {
      history.push({ role: "user", content: q });
      var typing = typingBubble();
      setBusy(true);
      var token = cfToken;
      var botRow = null, botText = null, acc = "", finished = false, quick = null;

      function cleanup() {
        setBusy(false); if (input) input.focus();
        cfToken = ""; // single-use; get a fresh token for the next message
        if (cfWidgetId !== null && window.turnstile) window.turnstile.reset(cfWidgetId);
      }
      function removeTyping() { if (typing && typing.remove) { typing.remove(); typing = null; } }
      function ensureBubble() {
        if (!botRow) { removeTyping(); botRow = bubble("", "bot"); botText = botRow.querySelector("div"); }
      }
      function finishStream() {
        if (finished) return; finished = true;
        if (acc) { setStatus("online"); history.push({ role: "assistant", content: acc }); quickChips(quick); }
        else { removeTyping(); if (botRow) botRow.remove(); fallback(); return; }
        cleanup();
      }
      // Non-streaming fallback (used if /chat/stream is unavailable or empty)
      function fallback() {
        fetch(API + "/chat", { method: "POST", headers: { "Content-Type": "application/json", "cf-turnstile-token": token }, body: JSON.stringify({ messages: history }) })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            removeTyping();
            if (d && d.reply) { setStatus("online"); history.push({ role: "assistant", content: d.reply }); bubble(d.reply, "bot"); }
            else { setStatus("offline"); bubble(ui.error, "bot"); }
          })
          .catch(function () { removeTyping(); setStatus("offline"); bubble(ui.error, "bot"); })
          .finally(cleanup);
      }

      fetch(API + "/chat/stream", { method: "POST", headers: { "Content-Type": "application/json", "cf-turnstile-token": token }, body: JSON.stringify({ messages: history }) })
        .then(function (r) {
          if (!r.ok || !r.body) throw 0;
          var reader = r.body.getReader();
          var dec = new TextDecoder();
          var buf = "";
          function pump() {
            return reader.read().then(function (res) {
              if (res.done) { finishStream(); return; }
              buf += dec.decode(res.value, { stream: true });
              var nl;
              while ((nl = buf.indexOf("\n")) >= 0) {
                var line = buf.slice(0, nl).trim(); buf = buf.slice(nl + 1);
                if (line.indexOf("data:") !== 0) continue;
                try {
                  var evt = JSON.parse(line.slice(5).trim());
                  if (evt.delta) { ensureBubble(); acc += evt.delta; botText.textContent = acc; log.scrollTop = log.scrollHeight; }
                  if (evt.done) { finishStream(); return; }
                } catch (e) { /* partial / keep-alive */ }
              }
              return pump();
            });
          }
          return pump();
        })
        .catch(function () { removeTyping(); if (botRow) botRow.remove(); fallback(); });
    }
    function send(q) {
      if (busy) return;
      q = (q || "").trim(); if (!q) return;
      bubble(q, "user");
      if (mode === "free") {
        var typing = typingBubble();
        setTimeout(function () { typing.remove(); bubble(freeAnswer(q), "bot"); }, 520);
      } else { aiSend(q); }
    }
    function start() {
      if (started) return; started = true;
      if (mode === "free") { bubble(free.greeting, "bot"); }
      else { mountTurnstile(); armGateTimer(); } // gate first; reveal only on pass, else show retry
    }
    root.querySelectorAll("[data-quick]").forEach(function (b) {
      b.addEventListener("click", function () { send(b.getAttribute("data-quick")); });
    });
    var retryBtn = root.querySelector("[data-cf-retry]");
    if (retryBtn) retryBtn.addEventListener("click", retryGate);
    if (form) form.addEventListener("submit", function (e) { e.preventDefault(); var v = input.value; input.value = ""; send(v); });
    root._chatStart = start;
  })();
</script>
<style is:global>
  .chat-typing { display: inline-flex; align-items: center; gap: 4px; }
  .chat-typing i { width: 7px; height: 7px; border-radius: 9999px; background: #1e293b; opacity: .4; animation: chatDot 1s infinite ease-in-out; }
  .chat-typing i:nth-child(2) { animation-delay: .15s; }
  .chat-typing i:nth-child(3) { animation-delay: .3s; }
  @keyframes chatDot { 0%, 60%, 100% { opacity: .25; transform: translateY(0); } 30% { opacity: .9; transform: translateY(-3px); } }
</style>
