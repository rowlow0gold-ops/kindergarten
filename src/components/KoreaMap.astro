---
interface Branch { slug: string; name: string; city: string; }
interface Props { branches: Branch[]; }
const { branches } = Astro.props;
const pos: Record<string, [number, number]> = {
  "seoul-gangnam": [112, 78],
  "busan-haeundae": [182, 268],
  "daejeon-yuseong": [120, 162],
  "daegu-suseong": [166, 208],
  "gwangju-namgu": [94, 252],
};
---
<svg viewBox="0 0 260 360" class="h-auto w-full max-w-[18rem]" role="img" aria-label="Campus map of Korea" xmlns="http://www.w3.org/2000/svg">
  <path d="M74 44 L120 40 L176 46 C188 72 196 108 204 146 C212 184 206 222 190 258 C174 292 146 312 116 308 C96 305 80 286 82 262 C68 246 58 232 62 214 C54 188 70 168 72 144 C66 120 78 96 74 70 Z" fill="rgba(255,255,255,0.13)" stroke="rgba(255,255,255,0.5)" stroke-width="1.5" stroke-linejoin="round" />
  {branches.map((b, i) => {
    const [x, y] = pos[b.slug] ?? [120, 180];
    return (
      <g>
        <circle cx={x} cy={y} r="13" fill="#c19a3e" stroke="#fff" stroke-width="2" />
        <text x={x} y={y + 5} text-anchor="middle" font-size="14" font-weight="600" font-family="Georgia, serif" fill="#16264d">{i + 1}</text>
        <text x={x} y={y + 28} text-anchor="middle" font-size="11" font-weight="600" fill="#fff" opacity="0.85">{b.city}</text>
      </g>
    );
  })}
</svg>
