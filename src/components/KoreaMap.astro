---
interface Branch { slug: string; name: string; city: string; }
interface Props { branches: Branch[]; }
const { branches } = Astro.props;
const pos: Record<string, [number, number]> = {
  "seoul-gangnam": [120, 78],
  "seoul-seocho": [103, 90],
  "busan-haeundae": [184, 256],
  "daejeon-yuseong": [126, 158],
  "daegu-suseong": [166, 200],
  "gwangju-namgu": [97, 250],
};
---
<svg viewBox="0 0 240 320" class="h-auto w-full max-w-md" role="img" aria-label="Map of campuses across Korea" xmlns="http://www.w3.org/2000/svg">
  <path d="M95 35 C110 28 140 30 152 42 C165 50 175 60 178 80 C182 100 188 115 200 125 C210 135 205 155 198 168 C205 180 218 188 212 205 C206 225 195 245 182 262 C172 275 158 282 140 286 C120 290 100 288 86 280 C74 274 66 262 66 246 C60 232 50 222 48 205 C47 188 56 176 62 166 C56 150 58 130 66 110 C72 92 80 70 88 52 C90 45 92 40 95 35 Z" fill="#1f335f" />
  {branches.map((b, i) => {
    const [x, y] = pos[b.slug] ?? [120, 160];
    return (
      <g>
        <circle cx={x} cy={y} r="12" fill="#c19a3e" stroke="#fff" stroke-width="2" />
        <text x={x} y={y + 4.5} text-anchor="middle" font-size="13" font-weight="600" font-family="Georgia, serif" fill="#1f335f">{i + 1}</text>
      </g>
    );
  })}
</svg>
