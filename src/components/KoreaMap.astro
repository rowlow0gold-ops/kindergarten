---
interface Branch { slug: string; name: string; city: string; }
interface Props { branches: Branch[]; }
const { branches } = Astro.props;
const pos: Record<string, [number, number]> = {
  "seoul-gangnam": [95, 88], "busan-haeundae": [150, 230], "daejeon-yuseong": [110, 150],
  "daegu-suseong": [140, 192], "gwangju-namgu": [86, 222],
};
---
<svg viewBox="0 0 220 340" class="h-auto w-full max-w-[17rem]" role="img" aria-label="Campus map of Korea" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <radialGradient id="land" cx="42%" cy="30%" r="80%">
      <stop offset="0%" stop-color="rgba(255,255,255,0.24)" />
      <stop offset="100%" stop-color="rgba(255,255,255,0.06)" />
    </radialGradient>
    <filter id="glow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="2.5" result="b" /><feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
  </defs>
  <path d="M60 58 C82 46 120 44 146 56 C156 74 162 104 170 136 C176 158 168 180 162 198 C158 214 152 226 158 240 C151 250 137 250 126 246 C113 254 97 252 84 258 C74 262 65 253 66 240 C72 222 55 208 60 190 C66 172 55 156 64 138 C70 121 55 103 62 85 C66 73 56 65 60 58 Z" fill="url(#land)" stroke="rgba(255,255,255,0.6)" stroke-width="1.6" stroke-linejoin="round" />
  {branches.map((b, i) => {
    const [x, y] = pos[b.slug] ?? [110, 170];
    return (
      <g>
        <circle cx={x} cy={y} r="11" fill="none" stroke="#ddbd76" stroke-width="2">
          <animate attributeName="r" values="11;22;11" dur="2.6s" repeatCount="indefinite" begin={`${i * 0.3}s`} />
          <animate attributeName="opacity" values="0.8;0;0.8" dur="2.6s" repeatCount="indefinite" begin={`${i * 0.3}s`} />
        </circle>
        <circle cx={x} cy={y} r="11" fill="#c19a3e" stroke="#fff" stroke-width="2" filter="url(#glow)" />
        <text x={x} y={y + 4.5} text-anchor="middle" font-size="13" font-weight="600" font-family="Georgia, serif" fill="#16264d">{i + 1}</text>
        <text x={x} y={y + 26} text-anchor="middle" font-size="11" font-weight="600" fill="#fff" opacity="0.9">{b.city}</text>
      </g>
    );
  })}
</svg>
