---
import { useT, localizePath, type Locale } from "../i18n/ui";
import siteKo from "../data/site.json";
import siteEn from "../data/en/site.json";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useT(locale);
const site = locale === "en" ? siteEn : siteKo;
const p = (path: string) => localizePath(path, locale);
const year = new Date().getFullYear();
---
<footer class="bg-navy-900 text-white/80">
  <div class="mx-auto max-w-6xl px-5 py-14">
    <div>
      <p class="font-serif text-xl text-white">{site.name}</p>
      <p class="mt-3 max-w-md text-sm leading-relaxed text-white/70">{t("footer.tagline")}</p>
      <p class="mt-4 text-sm text-white/60">{site.email} · {site.phone}</p>
    </div>
  </div>
  <div class="border-t border-white/10">
    <p class="mx-auto max-w-6xl px-5 py-5 text-xs text-white/50">© {year} {site.name}. {t("footer.rights")}</p>
  </div>
</footer>
