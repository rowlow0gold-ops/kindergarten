---
import { useT, localizePath, type Locale } from "../i18n/ui";
import siteKo from "../data/site.json";
import siteEn from "../data/en/site.json";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useT(locale);
const site = locale === "en" ? siteEn : siteKo;
const p = (path: string) => localizePath(path, locale);
const year = new Date().getFullYear();
const links = [
  { href: p("/schools"), label: t("nav.schools") },
  { href: p("/about/milestones"), label: t("nav.milestones") },
  { href: p("/admissions"), label: t("nav.admissions") },
  { href: p("/contact"), label: t("nav.contact") },
];
---
<footer class="bg-navy-900 text-white/80">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 md:grid-cols-[2fr_1fr]">
    <div>
      <p class="font-serif text-xl text-white">{site.name}</p>
      <p class="mt-3 max-w-md text-sm leading-relaxed text-white/70">{t("footer.tagline")}</p>
      <p class="mt-4 text-sm text-white/60">{site.email} · {site.phone}</p>
    </div>
    <div>
      <p class="text-sm font-semibold text-white">{t("footer.quicklinks")}</p>
      <ul class="mt-3 space-y-2 text-sm">
        {links.map((l) => (<li><a href={l.href} class="text-white/70 transition hover:text-gold-soft">{l.label}</a></li>))}
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <p class="mx-auto max-w-6xl px-5 py-5 text-xs text-white/50">© {year} {site.name}. {t("footer.rights")}</p>
  </div>
</footer>
