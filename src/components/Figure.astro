---
import Molecule from "./Molecule.astro";
interface Props { src?: string; alt: string; class?: string; rounded?: string; }
const { src, alt, class: cls = "aspect-[4/3]", rounded = "rounded-2xl" } = Astro.props;
const has = !!src && src.length > 0;
---
<div class={`relative overflow-hidden ${rounded} ${cls}`}>
  {has ? (
    <img src={src} alt={alt} loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" />
  ) : (
    <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-cream text-navy/70">
      <Molecule class="w-14 h-14 float-slow" />
      <span class="px-4 text-center text-xs font-medium tracking-wide uppercase">{alt}</span>
    </div>
  )}
</div>
