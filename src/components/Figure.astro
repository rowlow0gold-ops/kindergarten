---
interface Props { src?: string; alt: string; class?: string; rounded?: string; cat?: string; }
const { src, alt, class: cls = "aspect-[4/3]", rounded = "rounded-none", cat = "school,classroom,children" } = Astro.props;
let img = src;
if (!img) {
  let h = 0; for (let i = 0; i < alt.length; i++) { h = (h * 31 + alt.charCodeAt(i)) >>> 0; }
  img = `https://loremflickr.com/900/700/${encodeURIComponent(cat)}?lock=${(h % 90) + 1}`;
}
---
<div class={`relative overflow-hidden bg-cream ${rounded} ${cls}`}>
  <img src={img} alt={alt} loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" />
</div>
