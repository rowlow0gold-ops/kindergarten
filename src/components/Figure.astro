---
interface Props { src?: string; alt: string; class?: string; rounded?: string; cat?: string; }
const { src, alt, class: cls = "aspect-[4/3]", rounded = "rounded-none", cat = "school" } = Astro.props;
let img = src;
if (!img) {
  const base = (cat.split(",")[0] || "school").trim() + "-" + alt;
  let h = 0; for (let i = 0; i < base.length; i++) { h = (h * 31 + base.charCodeAt(i)) >>> 0; }
  img = `https://picsum.photos/seed/${h % 1000}/900/700`;
}
---
<div class={`relative overflow-hidden bg-cream ${rounded} ${cls}`}>
  <img src={img} alt={alt} loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" />
</div>
