---
interface Props { class?: string; }
const { class: cls = "" } = Astro.props;
const cols = [78, 114, 150, 186, 222];
const rows = [128, 160, 192];
const hx = 150, hy = 160;
---
<svg class={cls} viewBox="0 0 320 270" fill="none" role="img" aria-label="Schedule a visit" xmlns="http://www.w3.org/2000/svg">
  <rect x="92" y="40" width="10" height="28" rx="5" fill="#c19a3e" />
  <rect x="218" y="40" width="10" height="28" rx="5" fill="#c19a3e" />
  <rect x="44" y="56" width="232" height="184" rx="16" fill="#fff" stroke="rgba(31,51,95,0.14)" stroke-width="1.5" />
  <path d="M44 72 a16 16 0 0 1 16 -16 h200 a16 16 0 0 1 16 16 v20 h-232 Z" fill="#1f335f" />
  {rows.map((y) => cols.map((x) => (x === hx && y === hy ? null : <circle cx={x} cy={y} r="5" fill="rgba(31,51,95,0.16)" />)))}
  <circle cx={hx} cy={hy} r="15" fill="#c19a3e" />
  <path d="M143 160 l5 6 l9 -12" stroke="#fff" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round" />
  <g>
    <rect x="222" y="196" width="58" height="42" rx="7" fill="#c19a3e" stroke="#fff" stroke-width="2" />
    <path d="M224 200 L251 219 L278 200" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
  </g>
</svg>
