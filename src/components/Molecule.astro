  <g stroke="currentColor" stroke-width="2">
    <path d="M60 18 L96 38 L96 80 L60 100 L24 80 L24 38 Z" />
    <path d="M60 18 L60 56 M96 38 L60 56 M24 38 L60 56 M60 56 L60 100 M60 56 L96 80 M60 56 L24 80" stroke-opacity="0.55" />
