---
import siteKo from "../data/site.json";
import siteEn from "../data/en/site.json";
import { getLocale, localizePath } from "../i18n/ui";
const locale = getLocale(Astro.url);
const site = locale === "en" ? siteEn : siteKo;
const p = (path: string) => localizePath(path, locale);
const c = locale === "en"
  ? { kakao: "KakaoTalk chat", bot: "Chat assistant", title: "Choose an assistant", hi: "How would you like help today? Pick an assistant below.", aiName: "AI Assistant", aiDesc: "Conversational AI — ask anything", simpleName: "Quick Menu Bot", simpleDesc: "Guided menu — no AI", demo: "Demo — both assistants are coming soon." }
  : { kakao: "카카오톡 상담", bot: "상담봇", title: "상담봇 선택", hi: "어떻게 도와드릴까요? 아래에서 상담 방식을 선택해 주세요.", aiName: "AI 상담봇", aiDesc: "대화형 AI에게 무엇이든 물어보세요", simpleName: "메뉴 상담봇", simpleDesc: "메뉴 기반 간편 안내 · AI 미사용", demo: "데모 — 두 상담봇 모두 준비 중입니다." };
---
<div data-bot-panel class="fixed right-4 z-[2000] hidden w-72 overflow-hidden rounded-2xl bg-white shadow-2xl ring-1 ring-black/10" style="bottom: calc(env(safe-area-inset-bottom,0px) + 150px)">
  <div class="flex items-center justify-between bg-navy-900 px-4 py-3 text-white">
    <span class="font-serif text-sm font-semibold">{c.title}</span>
    <button data-bot-close aria-label="Close" class="text-white/70 hover:text-white">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>
  <div class="px-4 py-4">
    <p class="text-sm leading-relaxed text-ink/80">{c.hi}</p>
    <div class="mt-3 flex flex-col gap-2.5">
      <button type="button" data-bot-ai class="group flex items-center gap-3 rounded-xl bg-navy-900 px-3.5 py-3 text-left text-white shadow-sm transition hover:brightness-110">
        <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-white/10 text-gold">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="12" rx="3"/><path d="M12 6V3"/><circle cx="12" cy="3" r="1"/><path d="M8.5 11v2M15.5 11v2"/></svg>
        </span>
        <span class="min-w-0">
          <span class="block text-sm font-semibold">{c.aiName}</span>
          <span class="block text-[11px] leading-snug text-white/65">{c.aiDesc}</span>
        </span>
      </button>
      <button type="button" data-bot-simple class="group flex items-center gap-3 rounded-xl border border-navy/15 bg-white px-3.5 py-3 text-left text-navy transition hover:bg-cream">
        <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-cream text-navy">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13M8 12h13M8 18h13"/><path d="M3 6h.01M3 12h.01M3 18h.01"/></svg>
        </span>
        <span class="min-w-0">
          <span class="block text-sm font-semibold">{c.simpleName}</span>
          <span class="block text-[11px] leading-snug text-ink/55">{c.simpleDesc}</span>
        </span>
      </button>
    </div>
    <p class="mt-3 text-[11px] leading-snug text-ink/45">{c.demo}</p>
  </div>
</div>

<aside class="fixed right-4 z-[2000] flex flex-col items-end gap-3" style="bottom: calc(env(safe-area-inset-bottom,0px) + 88px)">
  <button data-bot-toggle class="cta-fab" style="background: var(--color-navy); color:#fff;" aria-label={c.bot}>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="6" width="18" height="12" rx="3"/><path d="M12 6V3"/><circle cx="12" cy="3" r="1"/><path d="M8.5 11v2M15.5 11v2"/>
    </svg>
    <span class="cta-tip">{c.bot}</span>
  </button>
  <a href={site.kakaoUrl} target="_blank" rel="noopener noreferrer" class="cta-fab" style="background:#FEE500; color:#181600;" aria-label="KakaoTalk">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 3C6.48 3 2 6.58 2 11c0 2.7 1.7 5.07 4.27 6.52L5 22l4.9-2.6c.69.08 1.39.13 2.1.13 5.52 0 10-3.58 10-8s-4.48-8.53-10-8.53Z"/>
    </svg>
    <span class="cta-tip">{c.kakao}</span>
  </a>
</aside>

<style>
  .cta-fab { position: relative; display: inline-flex; align-items: center; justify-content: center; width: 3.25rem; height: 3.25rem; border-radius: 9999px; box-shadow: 0 10px 22px -8px rgba(0,0,0,.4); transition: transform .18s ease, filter .18s ease; }
  .cta-fab:hover { transform: translateY(-2px); filter: brightness(.97); }
  .cta-tip { position: absolute; right: calc(100% + 10px); top: 50%; transform: translateY(-50%) translateX(6px); white-space: nowrap; background: rgba(19,31,62,.94); color:#fff; font-size:.75rem; font-weight:600; padding:.45rem .7rem; border-radius:.5rem; opacity:0; pointer-events:none; transition: opacity .16s ease, transform .16s ease; }
  .cta-fab:hover .cta-tip, .cta-fab:focus-visible .cta-tip { opacity:1; transform: translateY(-50%) translateX(0); }
</style>

<script>
  const toggle = document.querySelector("[data-bot-toggle]");
  const panel = document.querySelector("[data-bot-panel]");
  const close = document.querySelector("[data-bot-close]");
  toggle?.addEventListener("click", () => panel?.classList.toggle("hidden"));
  close?.addEventListener("click", () => panel?.classList.add("hidden"));
</script>
