---
import siteKo from "../data/site.json";
import siteEn from "../data/en/site.json";
import { getLocale } from "../i18n/ui";
import ChatApp from "./ChatApp.astro";
const locale = getLocale(Astro.url);
const en = locale === "en";
const site = locale === "en" ? siteEn : siteKo;
const c = en
  ? { kakao: "KakaoTalk chat", whatsapp: "WhatsApp", ai: "AI Chatbot", free: "Chatbot" }
  : { kakao: "카카오톡 상담", whatsapp: "왓츠앱", ai: "AI 챗봇", free: "챗봇" };
---
<ChatApp mode="ai" locale={locale} />
<ChatApp mode="free" locale={locale} />

<aside class="fixed right-4 z-[2000] flex flex-col items-end gap-3" style="bottom: calc(env(safe-area-inset-bottom,0px) + 88px)">
  <button data-open-ai class="cta-fab" style="background: var(--color-navy); color: var(--color-gold);" aria-label={c.ai}>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="4" y="8" width="16" height="10" rx="2.5"/><path d="M12 4.8V8"/><circle cx="12" cy="3.6" r="1.3"/><circle cx="9.2" cy="13" r="1.25" fill="currentColor" stroke="none"/><circle cx="14.8" cy="13" r="1.25" fill="currentColor" stroke="none"/><path d="M2.6 12v2.6M21.4 12v2.6"/>
    </svg>
    <span class="cta-tip">{c.ai}</span>
  </button>
  <button data-open-free class="cta-fab ring-1 ring-black/10" style="background:#fff; color: var(--color-navy);" aria-label={c.free}>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z"/>
    </svg>
    <span class="cta-tip">{c.free}</span>
  </button>
  <a href={site.kakaoUrl} target="_blank" rel="noopener noreferrer" class="cta-fab" style="background:#FEE500; color:#181600;" aria-label="KakaoTalk">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 3C6.48 3 2 6.58 2 11c0 2.7 1.7 5.07 4.27 6.52L5 22l4.9-2.6c.69.08 1.39.13 2.1.13 5.52 0 10-3.58 10-8s-4.48-8.53-10-8.53Z"/>
    </svg>
    <span class="cta-tip">{c.kakao}</span>
  </a>
  <a href={site.whatsappUrl} target="_blank" rel="noopener noreferrer" class="cta-fab" style="background:#25D366; color:#fff;" aria-label="WhatsApp">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.9c0 2.1.55 4.06 1.6 5.83L2 22l4.4-1.15a9.86 9.86 0 0 0 5.64 1.74c5.46 0 9.9-4.45 9.9-9.9 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm-2.86 6.1c.16 0 .32 0 .46.01.14.01.34-.06.54.41.2.48.68 1.66.74 1.78.06.12.1.26.02.42-.08.16-.12.26-.24.4-.12.14-.25.31-.36.42-.12.12-.25.25-.11.49.14.24.62 1.02 1.33 1.66.92.82 1.69 1.07 1.93 1.19.24.12.38.1.52-.06.14-.16.6-.7.76-.94.16-.24.32-.2.54-.12.22.08 1.4.66 1.64.78.24.12.4.18.46.28.06.1.06.58-.14 1.14-.2.56-1.16 1.07-1.62 1.14-.41.06-.94.08-1.51-.1-.35-.1-.8-.25-1.37-.5-2.41-1.04-3.98-3.46-4.1-3.62-.12-.16-.98-1.3-.98-2.48 0-1.18.62-1.76.84-2 .22-.24.48-.3.64-.3Z"/></svg>
    <span class="cta-tip">{c.whatsapp}</span>
  </a>
</aside>

<style>
  .cta-fab { position: relative; display: inline-flex; align-items: center; justify-content: center; width: 3.25rem; height: 3.25rem; border-radius: 9999px; box-shadow: 0 10px 22px -8px rgba(0,0,0,.4); transition: transform .18s ease, filter .18s ease; }
  .cta-fab:hover { transform: translateY(-2px); filter: brightness(.97); }
  .cta-tip { position: absolute; right: calc(100% + 10px); top: 50%; transform: translateY(-50%) translateX(6px); white-space: nowrap; background: rgba(19,31,62,.94); color:#fff; font-size:.75rem; font-weight:600; padding:.45rem .7rem; border-radius:.5rem; opacity:0; pointer-events:none; transition: opacity .16s ease, transform .16s ease; }
  .cta-fab:hover .cta-tip, .cta-fab:focus-visible .cta-tip { opacity:1; transform: translateY(-50%) translateX(0); }
</style>

<script>
  function openChat(mode) {
    document.querySelectorAll("[data-chat]").forEach((el) => { el.classList.add("hidden"); el.classList.remove("flex"); });
    const el = document.querySelector(`[data-chat="${mode}"]`);
    if (el) {
      el.classList.remove("hidden"); el.classList.add("flex");
      if (el._chatStart) el._chatStart();
      const inp = el.querySelector("[data-chat-input]");
      if (inp) setTimeout(() => inp.focus(), 30);
    }
  }
  document.querySelectorAll("[data-open-ai]").forEach((b) => b.addEventListener("click", () => openChat("ai")));
  document.querySelectorAll("[data-open-free]").forEach((b) => b.addEventListener("click", () => openChat("free")));
  document.querySelectorAll("[data-chat-close]").forEach((b) => b.addEventListener("click", () => {
    const el = b.closest("[data-chat]"); if (el) { el.classList.add("hidden"); el.classList.remove("flex"); }
  }));
  function closeChats() {
    document.querySelectorAll("[data-chat]").forEach((el) => { el.classList.add("hidden"); el.classList.remove("flex"); });
  }
  // Click anywhere outside the popups (and not on an opener) closes them
  document.addEventListener("pointerdown", (e) => {
    const t = e.target;
    if (!t.closest("[data-chat]") && !t.closest("[data-open-ai]") && !t.closest("[data-open-free]")) closeChats();
  });
  // Esc closes everything too
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeChats(); });
</script>
