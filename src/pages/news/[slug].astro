---
import Layout from "../../layouts/Layout.astro";
import NewsDetail from "../../components/page/NewsDetail.astro";
import news from "../../data/news.json";
export function getStaticPaths(){ return news.filter((n)=>!n.href).map((n)=>({ params:{ slug:n.slug }, props:{ item:n } })); }
const { item } = Astro.props;
---
<Layout title={`${item.title} · 한빛국제유치원`}><NewsDetail locale="ko" item={item} /></Layout>
