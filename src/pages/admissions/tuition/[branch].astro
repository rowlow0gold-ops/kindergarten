---
import Layout from "../../../layouts/Layout.astro";
import TuitionDetail from "../../../components/page/TuitionDetail.astro";
import branches from "../../../data/branches.json";
export function getStaticPaths(){ return branches.map((b)=>({ params:{ branch:b.slug }, props:{ branch:b } })); }
const { branch } = Astro.props;
---
<Layout title={`${branch.name} 학비 · 한빛국제과학학교`}><TuitionDetail locale="ko" branch={branch} /></Layout>
