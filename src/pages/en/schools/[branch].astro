---
import Layout from "../../../layouts/Layout.astro";
import BranchPage from "../../../components/page/BranchPage.astro";
import branches from "../../../data/en/branches.json";
export function getStaticPaths() {
  return branches.map((b) => ({ params: { branch: b.slug }, props: { branch: b } }));
}
const { branch } = Astro.props;
---
<Layout title={`${branch.name} · Hanbit International School of Science`}><BranchPage locale="en" branch={branch} /></Layout>
