---
import Layout from "../../layouts/Layout.astro";
import EventDetail from "../../components/page/EventDetail.astro";
import events from "../../data/events.json";
export function getStaticPaths(){ return events.map((e)=>({ params:{ slug:e.slug }, props:{ item:e } })); }
const { item } = Astro.props;
---
<Layout title={`${item.title} · 한빛국제유치원`}><EventDetail locale="ko" item={item} /></Layout>
